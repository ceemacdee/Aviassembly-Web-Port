      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="19">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Aviassembly</string>
        </Properties>
        <Item class="Folder" referent="21">
          <Properties>
            <string name="Name">Game</string>
          </Properties>
          <Item class="ModuleScript" referent="22">
            <Properties>
              <string name="Name">Flight</string>
              <string name="Source"><![CDATA[--!strict
-- Flight physics, ported from PlaneContainer, PlaneController, Wing, Engine, Wheel, Balloon, Parachute, Airbreak,
-- AirTurbine, Decoupler, PartExploder and DragSimulator.
--
-- The Roblox world is the Unity world mirrored on X. To keep every formula identical to the original, all
-- maths here runs in Unity space: positions/velocities/forces are converted with U(v) (mirror X) and angular
-- quantities (pseudo-vectors) with A(v). Unity masses are rb.mass (part weight / 15); forces are scaled by
-- k = Roblox assembly mass / Unity mass so accelerations match.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Parts = require(Shared.Data.Parts)
local Constants = require(Shared.Data.Constants)
local Fuselage = require(Shared.Fuselage)
local MathUtil = require(Shared.Util.MathUtil)
local Frames = require(script.Parent.Frames)
local PartVisual = require(script.Parent.PartVisual)
local PlaneDesign = require(script.Parent.PlaneDesign)

local PC = Constants.PlaneContainer
local CTRL = Constants.PlaneController
local DRAG = Constants.DragSimulator

local Flight = {}
Flight.__index = Flight

Flight.Gravity = PC.gravityForce * PC.planeGravityMultiplier -- 25.5 studs/s^2 (1 stud = 1 m)
local GRAVITY_MULT = PC.planeGravityMultiplier
local UNITY_STEP = 0.02 -- Unity fixed timestep the per-step constants were tuned for

local function U(v: Vector3): Vector3
	return Vector3.new(-v.X, v.Y, v.Z)
end
local function A(v: Vector3): Vector3
	return Vector3.new(v.X, -v.Y, -v.Z)
end
local clamp01 = MathUtil.clamp01
local lerp = MathUtil.lerp
local sign = MathUtil.sign
local function safeUnit(v: Vector3): Vector3
	local m = v.Magnitude
	return if m > 1e-9 then v / m else Vector3.zero
end
local function signedAngle(from: Vector3, to: Vector3, axis: Vector3): number
	local fm, tm = from.Magnitude, to.Magnitude
	if fm < 1e-9 or tm < 1e-9 then
		return 0
	end
	local a = math.deg(math.acos(math.clamp(from:Dot(to) / (fm * tm), -1, 1)))
	return if axis:Dot(from:Cross(to)) < 0 then -a else a
end

export type Input = {
	pitch: number,
	roll: number,
	yaw: number,
	throttle: number, -- -1, 0, 1
	space: boolean,
	retractPressed: boolean,
	decouplePressed: boolean,
	autoSteer: boolean,
}

-- ------------------------------------------------------------------------------------------- construction
function Flight.new(design: any, spawnCFrame: CFrame, options: any)
	local self = setmetatable({}, Flight)
	self.options = options or {}
	self.infiniteFuel = self.options.infiniteFuel == true
	self.campaign = self.options.campaign
	self.exploded = false
	self.currentThrottle = 0
	self.throttleVelocity = 0
	self.rudderInputSmooth = 0
	self.rudderVelocity = 0
	self.prevSpeed = 0
	self.prevVelocity = Vector3.zero
	self.liftMultiplier = 1
	self.helicopter = 0
	self.currentLift = 0
	self.retracted = false
	self.yawDrag = PC.yawDrag
	self.rollForce = CTRL.rollForce
	self.yawForce = CTRL.yawForce
	self.time = 0

	local model = Instance.new("Model")
	model.Name = "Plane"
	self.model = model
	self.entries = {}
	self.parts = {} -- per placed part: { entry, built, comps, weight, alive }

	-- Build all parts at their world positions.
	local totalWeight = 0
	local comSum = Vector3.zero
	for _, e in design.parts do
		local cf = spawnCFrame * e.cf
		local built = PartVisual.create(e.name, cf, e.flip, e.fuselage, { color = e.color and Color3.new(e.color[1], e.color[2], e.color[3]) or nil })
		built.model.Parent = model
		local stats = PlaneDesign.partStats(e)
		local center = Vector3.zero
		local n = 0
		for _, v in built.visuals do
			center += v.Position
			n += 1
		end
		center = if n > 0 then center / n else cf.Position
		local p = { entry = e, built = built, weight = stats.weight, cargo = stats.cargo, alive = true, cf = cf, center = center }
		table.insert(self.parts, p)
		totalWeight += stats.weight
		comSum += center * stats.weight
	end
	local com = if totalWeight > 0 then comSum / totalWeight else spawnCFrame.Position

	-- Root at the centre of mass, oriented like the design frame.
	local root = Instance.new("Part")
	root.Name = "PlaneRoot"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	root.CFrame = spawnCFrame.Rotation + com
	root.Parent = model
	model.PrimaryPart = root
	self.root = root

	-- Ballast carries fuel and cargo mass at the centre of mass (rb.mass = parts + fuel*0.4/15 + cargo/15).
	local ballast = Instance.new("Part")
	ballast.Name = "Ballast"
	ballast.Size = Vector3.new(0.5, 0.5, 0.5)
	ballast.Transparency = 1
	ballast.CanCollide = false
	ballast.CanQuery = false
	ballast.CanTouch = false
	ballast.CFrame = root.CFrame
	ballast.Parent = model
	self.ballast = ballast

	-- Colliders get a density so each part's mass is proportional to its weight (keeps the CoM like Unity's).
	for _, p in self.parts do
		local data = Parts[p.entry.name]
		local isWheel = false
		for _, c in data.components do
			if c.type == "Wheel" then
				isWheel = true
			end
		end
		local volume = 0
		for _, c in p.built.colliders do
			volume += c.Size.X * c.Size.Y * c.Size.Z
		end
		local density = math.clamp(p.weight / math.max(volume, 1e-3), 0.01, 100)
		for _, c in p.built.colliders do
			c.CustomPhysicalProperties = PhysicalProperties.new(density, 0.3, 0, 1, 1)
			c.CanCollide = not isWheel
			c.Massless = false
		end
		if #p.built.colliders == 0 then
			-- make sure the part still has mass
			local m = Instance.new("Part")
			m.Name = "Collider"
			m.Size = Vector3.new(0.3, 0.3, 0.3)
			m.Transparency = 1
			m.CanCollide = false
			m.CanQuery = false
			m.CFrame = CFrame.new(p.center)
			m.CustomPhysicalProperties = PhysicalProperties.new(math.clamp(p.weight / 0.027, 0.01, 100), 0.3, 0, 1, 1)
			m.Parent = p.built.model
			table.insert(p.built.colliders, m)
		end
	end
	local spinning = {}
	for _, p in self.parts do
		p.spinners = {}
		for _, s in p.built.spinners do
			spinning[s.part] = { p = p, axis = s.axis }
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			local spin = spinning[d]
			if spin then
				-- propellers use a Weld whose offset is animated
				local w = Instance.new("Weld")
				w.Part0 = root
				w.Part1 = d
				w.C0 = root.CFrame:Inverse() * d.CFrame
				w.Parent = d
				local axisWorld = spin.p.cf:VectorToWorldSpace(spin.axis)
				table.insert(spin.p.spinners, { weld = w, baseC0 = w.C0, axis = d.CFrame:VectorToObjectSpace(axisWorld).Unit })
			else
				local w = Instance.new("WeldConstraint")
				w.Part0 = root
				w.Part1 = d
				w.Parent = d
			end
			d.Anchored = false
		end
	end
	root.Anchored = false
	model.Parent = Workspace

	-- Physics components in root-local Roblox space.
	local rootInv = root.CFrame:Inverse()
	self.wings, self.engines, self.wheels, self.balloons, self.drags, self.turbines, self.decouplers = {}, {}, {}, {}, {}, {}, {}
	self.fuelCapacity = 1
	self.batteryCapacity = 0.05
	self.cargoVolume = 0
	self.hasBalloons = false
	self.hasRetractableGear = false
	self.cockpitForward = nil :: Vector3?
	for _, p in self.parts do
		local e = p.entry
		local data = Parts[e.name]
		if data.retractable then
			self.hasRetractableGear = true
			p.retractable = true
		end
		if string.find(e.name, "Cock") then
			self.cockpitForward = rootInv:VectorToWorldSpace(p.cf.ZVector)
		end
		self.cargoVolume += math.abs(p.cargo)
		for _, comp in data.components do
			if comp.active ~= false then
				local f = comp.frame
				local lp = rootInv * Frames.worldPoint(p.cf, e.flip, Frames.v(f.pos))
				local function dir(v)
					return rootInv:VectorToWorldSpace(p.cf:VectorToWorldSpace(Frames.v(v)))
				end
				local scaleSign = if comp.path == "" and e.flip then -1 else 1
				local d = comp.data
				local c = { part = p, data = d, pos = lp, right = dir(f.right), up = dir(f.up), forward = dir(f.forward), scaleSign = scaleSign }
				if comp.type == "Wing" then
					local o = d.orientation
					c.oPos = rootInv * Frames.worldPoint(p.cf, e.flip, Frames.v(o.pos))
					c.oRight, c.oUp, c.oForward = dir(o.right), dir(o.up), dir(o.forward)
					c.area = d.area[1] * d.area[2]
					table.insert(self.wings, c)
					self.fuelCapacity += math.abs(d.fuel or 0)
				elseif comp.type == "Engine" then
					c.throttle = 0
					c.maxPower = 1
					table.insert(self.engines, c)
				elseif comp.type == "Wheel" then
					c.prevHit = d.suspentionLength
					c.weightSamples = {}
					table.insert(self.wheels, c)
				elseif comp.type == "FuelTank" then
					self.fuelCapacity += math.abs(d.volume or 0)
				elseif comp.type == "Battery" then
					self.batteryCapacity += math.abs(d.capacity or 0)
				elseif comp.type == "Balloon" then
					self.hasBalloons = true
					table.insert(self.balloons, c)
				elseif comp.type == "Parachute" then
					c.multiplier = 1.5
					table.insert(self.drags, c)
				elseif comp.type == "Airbreak" then
					c.multiplier = 1.25
					table.insert(self.drags, c)
				elseif comp.type == "AirTurbine" then
					table.insert(self.turbines, c)
				elseif comp.type == "Decoupler" then
					table.insert(self.decouplers, c)
				end
			end
		end
	end
	self.fuel = self.fuelCapacity
	self.electricity = self.batteryCapacity

	-- Local bounding box (for ground distance and the camera).
	local minV, maxV = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, p in self.parts do
		for _, v in p.built.visuals do
			local lp = rootInv * v.Position
			local h = v.Size / 2
			minV = minV:Min(lp - h)
			maxV = maxV:Max(lp + h)
		end
	end
	if minV.X == math.huge then
		minV, maxV = -Vector3.one, Vector3.one
	end
	self.boundsCenter = (minV + maxV) / 2
	self.boundsHalf = (maxV - minV) / 2
	self.planeLength = math.max(self.boundsHalf.X, self.boundsHalf.Z)

	-- Forward direction (PlaneContainer.UpdateForwardDirection), in root-local Roblox space.
	local forward = Vector3.zAxis
	if self.cockpitForward then
		forward = self.cockpitForward
	end
	local engineSum = Vector3.zero
	for _, c in self.engines do
		engineSum += self:engineDirLocal(c)
	end
	if #self.engines > 0 then
		local avg = safeUnit(engineSum / #self.engines)
		self.helicopter = math.abs(avg:Dot(Vector3.yAxis))
		if self.helicopter <= 0.5 then
			forward = avg
		end
	end
	self.localForward = safeUnit(forward)
	if #self.wings == 0 then
		self.helicopter = 1
	end

	self:classifyWings()
	self:updateControllability()
	self:updateMass()
	self.dragFactor, self.dragFactorRetracted = self:computeDrag()
	self.drag = self.dragFactor
	return self
end

-- ------------------------------------------------------------------------------------------- helpers (Unity space)
function Flight:engineDirLocal(c: any): Vector3
	local d = if c.data.helicopterRotor == 1 then c.up * c.scaleSign else c.right
	return d
end

function Flight:cf(): CFrame
	return self.root.CFrame
end

function Flight:worldU(localPos: Vector3): Vector3
	return U(self.root.CFrame * localPos)
end

function Flight:dirU(localDir: Vector3): Vector3
	return U(self.root.CFrame:VectorToWorldSpace(localDir))
end

function Flight:comU(): Vector3
	return U(self.root.AssemblyCenterOfMass)
end

function Flight:velocityU(): Vector3
	return U(self.root.AssemblyLinearVelocity)
end

function Flight:pointVelocityU(posU: Vector3): Vector3
	return U(self.root:GetVelocityAtPosition(U(posU)))
end

function Flight:upU(): Vector3
	return U(self.root.CFrame.UpVector)
end

function Flight:forwardU(): Vector3
	return self:dirU(self.localForward)
end

function Flight:unityMass(): number
	local w = 0
	for _, p in self.parts do
		if p.alive then
			w += p.weight
		end
	end
	local cargo = if self.campaign then self.campaign:cargoMass() else 0
	return (w + self.fuel * PC.fuelWeight + cargo) / 15
end

function Flight:updateMass()
	-- Ballast = fuel + cargo, with the same proportion between Roblox and Unity mass as the parts.
	local w = 0
	for _, p in self.parts do
		if p.alive then
			w += p.weight
		end
	end
	local cargo = if self.campaign then self.campaign:cargoMass() else 0
	local extra = self.fuel * PC.fuelWeight + cargo
	local partsMass = 0
	for _, p in self.parts do
		if p.alive then
			for _, c in p.built.colliders do
				partsMass += c:GetMass()
			end
		end
	end
	local perWeight = if w > 0 then partsMass / w else 1
	local targetMass = math.max(extra * perWeight, 0.001)
	local density = math.clamp(targetMass / (0.5 * 0.5 * 0.5), 0.01, 100)
	local size = math.clamp((targetMass / density) ^ (1 / 3), 0.05, 20)
	if math.abs(self.ballast.Size.X - size) > 0.001 then
		self.ballast.Size = Vector3.one * size
	end
	if not self.lastBallastDensity or math.abs(self.lastBallastDensity - density) > 0.005 * density then
		self.ballast.CustomPhysicalProperties = PhysicalProperties.new(density, 0.3, 0, 1, 1)
		self.lastBallastDensity = density
	end
	self.unityMassValue = self:unityMass()
end

function Flight:k(): number
	return self.root.AssemblyMass / math.max(self.unityMassValue or self:unityMass(), 1e-4)
end

-- rb.AddForceAtPosition (Unity-space force and position)
function Flight:addForceAt(forceU: Vector3, posU: Vector3, dt: number)
	if forceU ~= forceU or forceU.Magnitude > 1e7 then
		return
	end
	self.root:ApplyImpulseAtPosition(U(forceU) * self:k() * dt, U(posU))
end

function Flight:addForce(forceU: Vector3, dt: number)
	self:addForceAt(forceU, self:comU(), dt)
end

-- ApplyInertiaTensorAjustedTorque: a torque of I*x is an angular acceleration of x.
function Flight:addAngularAccel(accelU: Vector3, dt: number)
	if accelU ~= accelU then
		return
	end
	self.root.AssemblyAngularVelocity += A(accelU) * dt
end

function Flight:boundsWorldU(): (Vector3, number)
	local cf = self.root.CFrame
	local c = cf * self.boundsCenter
	local h = self.boundsHalf
	local ext = math.abs(cf.RightVector.Y) * h.X + math.abs(cf.UpVector.Y) * h.Y + math.abs(cf.LookVector.Y) * h.Z
	return U(c), ext
end

function Flight:rayParams(): RaycastParams
	if not self.params then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { self.model }
		params.IgnoreWater = true
		self.params = params
	end
	return self.params
end

function Flight:distanceFromGround(): number
	local centerU, extY = self:boundsWorldU()
	local hit = Workspace:Raycast(U(centerU), Vector3.new(0, -5000, 0), self:rayParams())
	if hit then
		return hit.Distance - extY
	end
	return math.huge
end

function Flight:isGrounded(): boolean
	return self:distanceFromGround() < 1
end

-- ------------------------------------------------------------------------------------------- drag (DragSimulator)
-- Unity rendered the plane from the front with a replacement shader and averaged (1 - _DragFactor). Here a grid
-- of rays along the flight direction finds the first surface hit at each "pixel".
local function srgb(c: number): number
	return if c <= 0.0031308 then c * 12.92 else 1.055 * c ^ (1 / 2.4) - 0.055
end

function Flight:computeDrag(): (number, number)
	local function surfaceDrag(inst: Instance): number
		local model = inst:FindFirstAncestorOfClass("Model")
		local name = model and model:GetAttribute("PartName")
		local data = name and Parts[name]
		if not data then
			return 0
		end
		if data.dragFactor and data.dragFactor > 0 then
			return data.dragFactor
		end
		return if data.category == "Wings" then 0.5 else 0
	end
	local function run(excludeRetractable: boolean): number
		local cf = self.root.CFrame
		local fwd = cf:VectorToWorldSpace(self.localForward)
		local upRef = if math.abs(fwd.Y) > 0.95 then cf.RightVector else Vector3.yAxis
		local right = fwd:Cross(upRef).Unit
		local up = right:Cross(fwd).Unit
		local center = cf * self.boundsCenter
		local radius = self.boundsHalf.Magnitude
		-- projected extents
		local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
		for _, p in self.parts do
			for _, v in p.built.visuals do
				local d = v.Position - center
				local hx = math.abs(v.CFrame.RightVector:Dot(right)) * v.Size.X / 2 + math.abs(v.CFrame.UpVector:Dot(right)) * v.Size.Y / 2 + math.abs(v.CFrame.LookVector:Dot(right)) * v.Size.Z / 2
				local hy = math.abs(v.CFrame.RightVector:Dot(up)) * v.Size.X / 2 + math.abs(v.CFrame.UpVector:Dot(up)) * v.Size.Y / 2 + math.abs(v.CFrame.LookVector:Dot(up)) * v.Size.Z / 2
				minX = math.min(minX, d:Dot(right) - hx)
				maxX = math.max(maxX, d:Dot(right) + hx)
				minY = math.min(minY, d:Dot(up) - hy)
				maxY = math.max(maxY, d:Dot(up) + hy)
			end
		end
		if minX == math.huge then
			return 0
		end
		local w, h = maxX - minX, maxY - minY
		local area = w * h
		local step = math.max(1 / 30, math.sqrt(area / 3000))
		local include = {}
		for _, p in self.parts do
			if not (excludeRetractable and p.retractable) then
				for _, v in p.built.visuals do
					table.insert(include, v)
				end
			end
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = include
		local sum, count = 0, 0
		local x = minX + step / 2
		while x < maxX do
			local y = minY + step / 2
			while y < maxY do
				local origin = center + right * x + up * y + fwd * (radius + 1)
				local hit = Workspace:Raycast(origin, -fwd * (radius * 2 + 2), params)
				if hit then
					sum += srgb(1 - surfaceDrag(hit.Instance))
				end
				count += 1
				y += step
			end
			x += step
		end
		if count == 0 then
			return 0
		end
		return sum / count * area * DRAG.dragMultiplier
	end
	local extended = lerp(DRAG.defaultDrag, run(false) * 0.04, DRAG.calculateDragWeight)
	local retracted = lerp(DRAG.defaultDrag, run(true) * 0.04, DRAG.calculateDragWeight)
	return extended, retracted
end

-- ------------------------------------------------------------------------------------------- wings & controls
function Flight:classifyWings()
	self.mainWings, self.tailWings = {}, {}
	local comU = self:comU()
	local fwd = self:forwardU()
	local up = self:upU()
	for _, w in self.wings do
		local pos = self:worldU(w.pos)
		local t = (pos - comU):Dot(fwd)
		local closest = comU + fwd * t
		local v = comU - closest
		local mag = v.Magnitude
		local num = fwd:Dot(safeUnit(v))
		if mag > self.planeLength * 0.25 and num > 0 and math.abs(self:dirU(w.oUp):Dot(up)) > 0.75 then
			table.insert(self.tailWings, { wing = w, distance = mag })
		else
			table.insert(self.mainWings, w)
		end
	end
end

function Flight:centerOfPressureU(): Vector3
	local up = self:upU()
	local comU = self:comU()
	local sum, total = Vector3.zero, 0
	for _, w in self.wings do
		if w.part.alive then
			local oUp = self:dirU(w.oUp)
			local d = math.abs(Vector3.yAxis:Dot(oUp))
			local force = w.area * (w.data.liftForce * 100) * d * d
			local t = math.abs(oUp:Dot(up))
			local origin = comU:Lerp(self:worldU(w.oPos), t)
			sum += origin * force
			total += force
		end
	end
	if total < 1e-9 then
		return comU
	end
	return sum / total
end

function Flight:liftOriginU(): Vector3
	local fwd, up = self:forwardU(), self:upU()
	local side = fwd:Cross(up)
	local comU = self:comU()
	local num = (self:centerOfPressureU() - comU):Dot(side)
	return comU + side * num * PC.liftSymmetry
end

function Flight:thrustOriginU(): Vector3
	local comU = self:comU()
	if #self.engines == 0 then
		return comU
	end
	local sum, n = Vector3.zero, 0
	for _, e in self.engines do
		if e.part.alive then
			sum += self:worldU(e.pos)
			n += 1
		end
	end
	if n == 0 then
		return comU
	end
	local t = lerp(PC.thrustSymmetry, 0, self.helicopter)
	return comU:Lerp(sum / n, t)
end

function Flight:updateWing(w: any, dt: number, aoaOffset: number)
	local oPos = self:worldU(w.oPos)
	local oRight, oUp, oForward = self:dirU(w.oRight), self:dirU(w.oUp), self:dirU(w.oForward)
	local pointVelocity = self:pointVelocityU(oPos)
	local airflow = -pointVelocity
	local lx, ly, lz = airflow:Dot(oRight), airflow:Dot(oUp), airflow:Dot(oForward)
	local aoa = math.deg(math.atan2(ly, math.abs(lz))) * (-sign(lz))
	local extra = math.max(aoaOffset - math.abs(aoa), 0)
	local lhs = -safeUnit(airflow):Cross(oRight) * w.scaleSign
	aoa += extra * sign(lhs:Dot(Vector3.yAxis))
	w.currentAngleOfAttack = aoa
	local speed = airflow.Magnitude
	-- ApplyLift
	if speed > w.data.maxSpeed * 0.8 then
		self.warnings["Wing stress too high"] = "Slow down to reduce stress"
	end
	if speed > w.data.maxSpeed then
		self:explodePart(w.part)
		return
	end
	local liftDir = -safeUnit(airflow):Cross(oRight)
	local lift = math.sin(math.abs(math.rad(aoa)) * 2) * sign(aoa) * speed * speed * w.area * w.data.liftForce
	local force = liftDir * lift * w.scaleSign * GRAVITY_MULT * self.liftMultiplier
	self:addForceAt(force, self:liftOriginU(), dt)
	self.currentLift += w.data.liftForce * speed * speed * w.area * 0.2
	-- ApplyDrag
	local drag = (0.5 - math.cos(math.rad(math.abs(aoa))) * 0.5) * speed * speed * w.area * w.data.dragForce
	self:addForceAt(-pointVelocity * drag, self:comU(), dt)
end

function Flight:updateControls(input: Input, dt: number)
	local v = self:velocityU()
	local speed = v.Magnitude
	local fwd, up = self:forwardU(), self:upU()
	local mass15 = self:unityMass() * 15
	local controlHandicap = 0.4 + clamp01(MathUtil.inverseLerp(50, 0, mass15)) * 0.6
	local num2 = safeUnit(v):Dot(fwd)
	local num3 = clamp01(speed / 50)
	local pitchAxis = safeUnit((-fwd):Cross(up))
	local groundFactor = clamp01(self:distanceFromGround() / 30)
	local rollSurface = clamp01(self.rollControlSurfaceLift * 150 * controlHandicap + self.helicopter)
	local roll = self.rollForce * lerp(num3, 1, self.helicopter)
	if input.autoSteer then
		roll *= groundFactor
	end
	self:addAngularAccel(-fwd * input.roll * roll * rollSurface, dt)
	local pitchSurface = clamp01(controlHandicap + self.pitchControlSurfaceLift * 40)
	local pitch = CTRL.pitchForce * lerp(num3 * num2, 1, self.helicopter)
	self:addAngularAccel(pitchAxis * input.pitch * pitch * pitchSurface, dt)
	local num10 = self.yawForce * clamp01(speed / 10) * num2
	local grounded = self:isGrounded()
	local num11 = if grounded then 1.25 else 1
	self:addAngularAccel(up * self.rudderInputSmooth * num10 * num11, dt)
	if input.autoSteer then
		local n2 = safeUnit(Vector3.yAxis:Cross(fwd))
		local n3 = safeUnit(fwd:Cross(n2))
		self.yawDrag = 0
		self.rollForce = 5
		self.yawForce = 1.5
		local currentRoll = self:currentRoll()
		local t = clamp01(MathUtil.inverseLerp(0.95, 0.99, math.abs(currentRoll)))
		local s = t * t * (3 - 2 * t)
		currentRoll *= 1 - s
		if math.abs(fwd:Dot(Vector3.yAxis)) > 0.98 then
			currentRoll = 0
		end
		local f = clamp01(math.abs(currentRoll) - 0.0125) * sign(currentRoll) * CTRL.rollTurnForce
		f = math.sqrt(math.abs(f)) * sign(f)
		self:addAngularAccel(n3 * f, dt)
		local n12 = math.sqrt(math.abs(currentRoll)) * sign(currentRoll)
		self:addAngularAccel(fwd * n12 * CTRL.rollRestoreForce, dt)
		self:addAngularAccel(n3 * (1 - groundFactor) * self.yawForce * num10 * input.roll * num11, dt)
	else
		self.yawDrag = 0.2
		self.rollForce = 3.5
		self.yawForce = 6
	end
end

function Flight:currentRoll(): number
	local fwd, up = self:forwardU(), self:upU()
	local n = safeUnit(MathUtil.projectOnPlane(Vector3.yAxis, fwd))
	local num = 1 - clamp01((up:Dot(n) + 1) * 0.5)
	local s = sign(signedAngle(up, n, fwd))
	return num * s
end

function Flight:stabilise(dt: number)
	local fwd = self:forwardU()
	local v = self:velocityU()
	-- PlaneStabilisationForce
	local m = 1 - self.helicopter
	local axis = safeUnit(safeUnit(v):Cross(fwd))
	local num = (1 - math.abs(fwd:Dot(safeUnit(v)))) * sign(signedAngle(fwd, safeUnit(v), axis))
	num *= v.Magnitude / 50
	num *= CTRL.stablisationForce
	if axis.Magnitude > 0 then
		self:addAngularAccel(axis * num * m, dt)
	end
	-- HelicopterStabilisationForce
	local up = self:upU()
	local hAxis = safeUnit(up:Cross(Vector3.yAxis))
	local hNum = (1 - math.abs(Vector3.yAxis:Dot(up))) * sign(signedAngle(up, Vector3.yAxis, hAxis)) * CTRL.helicopterStabilisationForce
	if hAxis.Magnitude > 0 then
		self:addAngularAccel(hAxis * hNum * self.helicopter, dt)
	end
end

function Flight:updateControllability()
	self.rollControlSurfaceLift = 0
	self.pitchControlSurfaceLift = 0
	for _, w in self.mainWings do
		if w.part.alive then
			self.rollControlSurfaceLift += w.data.liftForce
		end
	end
	for _, t in self.tailWings do
		if t.wing.part.alive then
			self.pitchControlSurfaceLift += t.wing.data.liftForce * t.distance
		end
	end
	self.rollControlSurfaceLift = math.max(self.pitchControlSurfaceLift, self.rollControlSurfaceLift)
end

-- ------------------------------------------------------------------------------------------- engines
function Flight:updateEngine(e: any, input: Input, dt: number, grounded: boolean)
	local num = input.throttle
	e.throttle += num * dt * CTRL.throttleSpeed
	if e.throttle <= 0 then
		e.throttle = MathUtil.moveTowards(e.throttle, num, dt * 10)
	end
	local minThrottle = if grounded or e.data.helicopterRotor == 1 then -0.75 else 0
	e.throttle = math.clamp(e.throttle, minThrottle, 1)
	local electric = e.data.electricEngine == 1
	if (if electric then self.electricity else self.fuel) <= 0 then
		e.effective = 0
		return
	end
	local thrust = e.data.thrust
	local consumption = e.data.fuelConsumption
	if e.data.useAfterburner == 1 then
		local ab = clamp01(e.throttle - 0.8) * 5
		thrust = MathUtil.lerpUnclamped(thrust, e.data.afterburnerThrust, ab)
		consumption = MathUtil.lerpUnclamped(consumption, e.data.afterburnerFuelConsumption, ab)
	end
	if #e.data.maxSpeed > 2 then
		thrust *= MathUtil.evaluateCurve(e.data.maxSpeed, self:velocityU().Magnitude)
	end
	-- Thrust acts at the thrust origin, at the centre of mass height.
	local rootCF = self.root.CFrame
	local originLocal = rootCF:PointToObjectSpace(U(self:thrustOriginU()))
	local comLocal = rootCF:PointToObjectSpace(self.root.AssemblyCenterOfMass)
	local at = U(rootCF * Vector3.new(originLocal.X, comLocal.Y, originLocal.Z))
	local dir = self:dirU(self:engineDirLocal(e))
	local handicap = clamp01(1 - (e.data.thrustHandicap or 0))
	self:addForceAt(dir * e.throttle * thrust * e.maxPower * handicap, at, dt)
	e.effective = e.throttle
	local use = if self.infiniteFuel then 0 else 1
	if electric then
		self.electricity -= math.abs(e.throttle) * consumption * e.maxPower * dt * use
	else
		self.fuel -= math.abs(e.throttle) * consumption * e.maxPower * dt * use
		self.electricity = math.min(self.electricity + dt * math.abs(e.throttle) * (e.data.electricityGeneration or 0), self.batteryCapacity)
	end
end

-- ------------------------------------------------------------------------------------------- wheels
function Flight:updateWheel(w: any, dt: number)
	local rootCF = self.root.CFrame
	local posR = rootCF * w.pos
	local upR = rootCF:VectorToWorldSpace(w.up)
	local downR = -upR * w.scaleSign
	local d = w.data
	local params = self:rayParams()
	local hit = Workspace:Raycast(posR - downR * d.rayUpOffset, downR * (d.suspentionLength + d.rayUpOffset), params)
	if not hit then
		w.prevHit = d.suspentionLength
		w.weightSamples = {}
		w.contact = nil
		return
	end
	local posU = U(posR)
	local normalU = U(hit.Normal)
	local rightU = self:dirU(w.right)
	local dist = math.clamp(hit.Distance - d.rayUpOffset, 0, d.suspentionLength)
	local compression = 1 - dist / d.suspentionLength
	local pv = self:pointVelocityU(posU)
	local compressionSpeed = (w.prevHit - dist) / dt
	local spring = d.suspensionStrenth * GRAVITY_MULT * compression
	local suspension = spring + d.suspensionDamping * compressionSpeed
	self:addForceAt(normalU * suspension, posU, dt)
	local lateral = rightU:Dot(pv)
	self:addForceAt(-rightU * lateral * d.traction * spring, posU, dt)
	local rolling = normalU:Cross(rightU)
	local f = rolling:Dot(pv)
	local friction = math.min(math.abs(f), d.maxFriction) * sign(f)
	friction *= lerp(3, 1, math.abs(self:forwardU():Dot(self:totalThrustU())))
	self:addForceAt(-rolling * friction * spring, posU, dt)
	w.prevHit = dist
	w.contact = hit.Position
	-- CheckWheelFailure
	local load = (suspension * normalU):Dot(Vector3.yAxis) / Flight.Gravity * 15
	if load > d.maxWeightCapacity then
		self.warnings["Wheel load too heavy"] = "Add more wheels or add stronger wheels"
	end
	local impact = pv:Dot(-normalU)
	if impact < 2 then
		table.insert(w.weightSamples, { t = self.time, v = load })
		while #w.weightSamples > 0 and self.time - w.weightSamples[1].t > 3 do
			table.remove(w.weightSamples, 1)
		end
		local minV = math.huge
		for _, s in w.weightSamples do
			minV = math.min(minV, s.v)
		end
		if #w.weightSamples > 30 and self.time - w.weightSamples[1].t > 2.9 and minV > d.maxWeightCapacity then
			self:explodePart(w.part)
		end
	end
	if impact > d.maxImpactVelocity then
		self:explodePart(w.part)
	end
end

function Flight:totalThrustU(): Vector3
	local sum, n = Vector3.zero, 0
	for _, e in self.engines do
		if e.part.alive then
			local alive = if self.fuel > 0 then 1 else 0
			sum += self:dirU(self:engineDirLocal(e)) * (e.throttle or 0) * alive
			n += 1
		end
	end
	return if n > 0 then sum / n else sum
end

-- ------------------------------------------------------------------------------------------- explosions
function Flight:explodeAt(position: Vector3, size: number)
	local ex = Instance.new("Explosion")
	ex.BlastPressure = 0
	ex.BlastRadius = 0
	ex.DestroyJointRadiusPercent = 0
	ex.ExplosionType = Enum.ExplosionType.NoCraters
	ex.Position = position
	ex.Parent = Workspace
end

-- PartExploder.ExplodePart: the part and everything attached to it break off.
function Flight:explodePart(p: any, quiet: boolean?)
	if not p.alive then
		return
	end
	local list = { p }
	local function addChildren(id: number)
		for _, other in self.parts do
			if other.alive and other.entry.parent == id and not table.find(list, other) then
				table.insert(list, other)
				addChildren(other.entry.id)
			end
		end
	end
	addChildren(p.entry.id)
	for _, q in list do
		q.alive = false
		for _, d in q.built.model:GetDescendants() do
			if d:IsA("WeldConstraint") or d:IsA("Weld") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.CanCollide = d.Name == "Collider"
			end
		end
		task.delay(8, function()
			q.built.model:Destroy()
		end)
	end
	if not quiet and #list > 0 then
		local pos = list[1].built.visuals[1] and list[1].built.visuals[1].Position or self.root.Position
		self:explodeAt(pos, 2)
	end
	-- ReInitializePlane: mass, cargo space, centre of mass.
	self.cargoVolume = 0
	for _, q in self.parts do
		if q.alive then
			self.cargoVolume += math.abs(q.cargo)
		end
	end
	if self.campaign then
		self.campaign:fitCargo(self.cargoVolume)
	end
	self:classifyWings()
	self:updateMass()
end

function Flight:explodePlane()
	if self.exploded then
		return
	end
	self.exploded = true
	self:explodeAt(self.root.Position, self.planeLength * 0.2)
	for _, p in self.parts do
		if p.alive then
			self:explodePart(p, true)
		end
	end
	if self.onExploded then
		self.onExploded()
	end
end

-- ------------------------------------------------------------------------------------------- main step
function Flight:step(dt: number, input: Input)
	if self.exploded or not self.root.Parent then
		return
	end
	dt = math.clamp(dt, 1 / 240, 1 / 15)
	self.time += dt
	self.warnings = {}
	self:updateMass()

	-- Throttle and rudder smoothing (PlaneController.UpdateThrottle)
	self.currentThrottle, self.throttleVelocity = MathUtil.smoothDamp(self.currentThrottle, input.throttle, self.throttleVelocity, CTRL.throttleSpeed, dt)
	self.rudderInputSmooth, self.rudderVelocity = MathUtil.smoothDamp(self.rudderInputSmooth, input.yaw, self.rudderVelocity, CTRL.rudderSmoothTime, dt)
	if input.yaw ~= 0 then
		self.rudderInputSmooth = input.yaw
	end

	-- Retractable gear / decoupler
	if input.retractPressed and self.hasRetractableGear then
		self.retracted = not self.retracted
		self.drag = if self.retracted then self.dragFactorRetracted else self.dragFactor
	end
	if input.decouplePressed then
		for _, d in self.decouplers do
			if d.part.alive then
				for _, other in self.parts do
					if other.alive and other.entry.parent == d.part.entry.id then
						self:explodePart(other, true)
					end
				end
			end
		end
	end

	local grounded = self:isGrounded()

	-- PlaneController.FixedUpdate
	self:updateControls(input, dt)
	self:stabilise(dt)
	self:updateControllability()
	local fwd, up = self:forwardU(), self:upU()
	local v = self:velocityU()
	local side = safeUnit(fwd:Cross(up))
	local traction = side:Dot(v) * CTRL.airTraction * self:unityMass()
	local upness = math.abs(up:Dot(Vector3.yAxis))
	self:addForce(-side * traction * upness, dt)
	local speed = v.Magnitude
	local t = (Vector3.yAxis:Dot(up) + 1) * 0.5
	local trigger = lerp(CTRL.minTriggerVelocity, CTRL.maxTriggerVelocity, t)
	if speed - self.prevSpeed < 0 and grounded then
		self.liftMultiplier = 1 - CTRL.landingHelper
	else
		self.liftMultiplier = 1
	end
	if math.abs(speed - self.prevSpeed) > trigger and self.time > 0.5 then
		self:explodePlane()
		return
	end
	if self.root.Position.Y < -12 then
		self:explodePlane()
		return
	end
	self.prevSpeed = speed

	-- PlaneContainer.FixedUpdate
	self.airbreakDrag = 1
	self.currentLift = 0
	local aoaOffset = if input.space then lerp(10, 0, clamp01(self:distanceFromGround() / 10)) else 0
	for _, w in self.wings do
		if w.part.alive then
			self:updateWing(w, dt, aoaOffset)
			if self.exploded then
				return
			end
		end
	end
	for _, e in self.engines do
		if e.part.alive then
			self:updateEngine(e, input, dt, grounded)
		end
	end
	for _, b in self.balloons do
		if b.part.alive then
			self:addForceAt(Vector3.yAxis * b.data.lift, self:comU(), dt)
			self.currentLift += up:Dot(Vector3.yAxis * b.data.lift)
		end
	end
	local braking = input.throttle < 0 and self:totalThrustU().Magnitude < 0.01 and v:Dot(fwd) > 0
	self.braking = braking
	for _, d in self.drags do
		if d.part.alive and braking then
			self.airbreakDrag += d.multiplier
		end
	end
	for _, tu in self.turbines do
		if tu.part.alive then
			self.electricity = math.clamp(self.electricity + speed / 200 * dt * (tu.data.capacity or 0), 0, self.batteryCapacity)
		end
	end
	for _, w in self.wheels do
		if w.part.alive and not (self.retracted and w.part.retractable) then
			self:updateWheel(w, dt)
		end
	end

	-- ApplyAngularDrag (pitch, yaw, roll in local axes; per Unity step)
	local omega = A(self.root.AssemblyAngularVelocity)
	local right = self:dirU(-Vector3.xAxis)
	local fwdLocalAxis = self:dirU(Vector3.zAxis)
	local wx, wy, wz = omega:Dot(right), omega:Dot(up), omega:Dot(fwdLocalAxis)
	local rate = dt / UNITY_STEP
	local dOmega = -(right * wx * PC.pitchDrag + up * wy * self.yawDrag + fwdLocalAxis * wz * PC.rollDrag) * rate
	-- rb.angularDamping = 2
	dOmega -= omega * (1 - 1 / (1 + 2 * dt))
	self.root.AssemblyAngularVelocity += A(dOmega)

	-- ApplyLiniarDrag(helicopter * verticalLiniarDrag) and rb.linearDamping
	local vertical = self.helicopter * PC.verticalLiniarDrag
	local b = (1 - math.abs(fwd:Dot(safeUnit(v)))) * PC.angleDragMultiplier + 1
	local num = lerp(1 - clamp01(fwd:Dot(-Vector3.yAxis)), b, self.helicopter)
	local damping = self.drag * num * self.airbreakDrag
	local vel = self.root.AssemblyLinearVelocity
	vel = Vector3.new(vel.X, vel.Y - vel.Y * vertical * rate, vel.Z)
	vel *= 1 / (1 + damping * dt)
	self.root.AssemblyLinearVelocity = vel

	-- Helicopter factor from the current engine direction
	local sum = Vector3.zero
	for _, e in self.engines do
		sum += self:dirU(self:engineDirLocal(e))
	end
	if #self.engines > 0 then
		self.helicopter = math.abs(up:Dot(safeUnit(sum / #self.engines)))
	end
	if #self.wings == 0 then
		self.helicopter = 1
	end

	-- Visuals: spin propellers (PropellerVisual)
	for _, e in self.engines do
		if e.part.alive then
			e.spin = (e.spin or 0) + (e.throttle or 0) * dt * 40
			for _, s in e.part.spinners or {} do
				if s.weld.Parent then
					s.weld.C0 = s.baseC0 * CFrame.fromAxisAngle(s.axis, e.spin)
				end
			end
		end
	end
	self.prevVelocity = self.root.AssemblyLinearVelocity
end

-- Values the HUD shows.
function Flight:telemetry()
	local v = self.root.AssemblyLinearVelocity
	local thr = 0
	local n = 0
	for _, e in self.engines do
		if e.part.alive then
			thr += e.throttle or 0
			n += 1
		end
	end
	return {
		speed = v.Magnitude,
		altitude = self.root.Position.Y,
		height = self:distanceFromGround(),
		throttle = if n > 0 then thr / n else 0,
		fuel = self.fuel,
		fuelCapacity = self.fuelCapacity,
		electricity = self.electricity,
		batteryCapacity = self.batteryCapacity,
		hasElectric = self.batteryCapacity > 0.05 + 1e-6,
		cargoVolume = self.cargoVolume,
		grounded = self:isGrounded(),
		warnings = self.warnings or {},
		retracted = self.retracted,
		braking = self.braking,
	}
end

function Flight:refuel()
	self.fuel = self.fuelCapacity
	self.electricity = self.batteryCapacity
end

function Flight:destroy()
	self.exploded = true
	if self.model then
		self.model:Destroy()
	end
end

return Flight
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">Frames</string>
              <string name="Source"><![CDATA[--!strict
-- Helpers for the coordinate conventions of this port.
--
-- All part data is Unity data mirrored on X. A part's Roblox CFrame `cf` maps mirrored part-local data to the
-- world, and the original "Unity" axes of a transform appear as:
--   unity forward = cf.ZVector,  unity up = cf.YVector,  unity right = -cf.XVector
-- Mirrored (symmetry) copies keep a proper rotation plus a `flip` flag that negates local Y on *positions*
-- only, exactly like Unity's negative localScale.y (directions/rotations ignore the scale sign in Unity too).
local Frames = {}

function Frames.v(t: { number }?): Vector3
	if not t then
		return Vector3.zero
	end
	return Vector3.new(t[1], t[2], t[3])
end

-- Equivalent of Unity's Quaternion.LookRotation(forward, up) in this port's convention.
function Frames.lookRotation(forward: Vector3, up: Vector3, position: Vector3?): CFrame
	local z = forward.Unit
	local x = up:Cross(z)
	if x.Magnitude < 1e-6 then
		x = (if math.abs(z.Y) < 0.9 then Vector3.yAxis else Vector3.xAxis):Cross(z)
	end
	x = x.Unit
	local y = z:Cross(x)
	return CFrame.fromMatrix(position or Vector3.zero, x, y, z)
end

-- Rotation taking vector `from` onto vector `to` (Quaternion.FromToRotation).
function Frames.fromToRotation(from: Vector3, to: Vector3): CFrame
	local f, t = from.Unit, to.Unit
	local d = math.clamp(f:Dot(t), -1, 1)
	if d > 0.99999 then
		return CFrame.identity
	end
	if d < -0.99999 then
		local axis = Vector3.xAxis:Cross(f)
		if axis.Magnitude < 1e-6 then
			axis = Vector3.yAxis:Cross(f)
		end
		return CFrame.fromAxisAngle(axis.Unit, math.pi)
	end
	return CFrame.fromAxisAngle(f:Cross(t).Unit, math.acos(d))
end

-- A local position inside a (possibly flipped) part.
function Frames.localPoint(p: Vector3, flip: boolean): Vector3
	return if flip then Vector3.new(p.X, -p.Y, p.Z) else p
end

function Frames.worldPoint(cf: CFrame, flip: boolean, p: Vector3): Vector3
	return cf * Frames.localPoint(p, flip)
end

function Frames.worldDir(cf: CFrame, d: Vector3): Vector3
	return cf:VectorToWorldSpace(d)
end

-- World CFrame of a stored frame {pos, right, up, forward} inside a part (rotation from directions,
-- position flipped if the part is flipped). Returned in the port convention (Z = unity forward).
function Frames.frameWorld(cf: CFrame, flip: boolean, frame: any): CFrame
	local pos = Frames.worldPoint(cf, flip, Frames.v(frame.pos))
	local forward = cf:VectorToWorldSpace(Frames.v(frame.forward))
	local up = cf:VectorToWorldSpace(Frames.v(frame.up))
	return Frames.lookRotation(forward, up, pos)
end

function Frames.reflect(v: Vector3, normal: Vector3): Vector3
	return v - normal * (2 * v:Dot(normal))
end

function Frames.encodeCFrame(cf: CFrame): { number }
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return { x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 }
end

function Frames.decodeCFrame(t: { number }): CFrame
	return CFrame.new(table.unpack(t))
end

return Frames
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="24">
            <Properties>
              <string name="Name">Hangar</string>
              <string name="Source"><![CDATA[--!strict
-- Build mode (PartPlacer, PartBar, CategoryBar, PlaneStats, ProceduralFuselage gizmos, ResearchPanel).
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Parts = require(Shared.Data.Parts)
local Research = require(Shared.Data.Research)
local Fuselage = require(Shared.Fuselage)
local MathUtil = require(Shared.Util.MathUtil)
local Frames = require(script.Parent.Frames)
local PartVisual = require(script.Parent.PartVisual)
local PlaneDesign = require(script.Parent.PlaneDesign)
local UI = require(script.Parent.UI)

local C = UI.Colors
local Hangar = {}
Hangar.__index = Hangar

local SNAP_DISTANCE = 0.75
local CATEGORIES = { "Cockpits", "Engines", "Wings", "Wheels", "Utility", "Electric" }
local CATEGORY_TITLES = { Cockpits = "Body", Engines = "Engines", Wings = "Wings", Wheels = "Wheels", Utility = "Misc", Electric = "Electric" }
-- Part order inside each category, from the original PartBars.
local ORDER = {
	Cockpits = { "Body", "BiplaneCockpit", "Cockpit", "JetCockpit", "PrivateJetCockpit", "BigCockpit", "SmallHelicopterCockpit", "SmallLargeCockpit", "JetlineCockpit", "GliderCockpit", "JetCockpit02", "SmallPlaneCockpit", "AreoDynamicCockpit", "HugeCockpit", "HelicopterCockpit", "LargeBody", "Connector", "Nose", "SharpNose", "Tail" },
	Engines = { "WoodEngine", "Engine", "SmallPropEngine", "TurboProp", "SmallJetEngine", "JetEngine", "FighterJetEngine", "RocketEngine", "ElectricEngine", "BigElectricEngine", "PropfanEngine", "RamJet", "HelicopterEngine", "HelicopterEngineSmall", "HugePropEngine" },
	Wings = { "WoodWing", "BiplaneWing", "TailWing", "Wing", "ElectronWing", "StraightWing", "SmallJetWing", "BigWing", "Tailwing02", "DeltaWing01", "Tailwing03", "DeltaWing02", "Tailwing04", "SmallCanard", "SmallRecreationalWing", "GliderWing" },
	Wheels = { "BikeWheel", "SmallRearWheel", "RearWheel", "OldSteelWheel", "BigOldWheel", "AeroWheel", "AeroWheelLong", "Wheel01", "SmallRetractableGear", "Wheel03", "BigRetractableGear", "TinyRetractableGear", "HelicopterLandingGear" },
	Utility = { "WoodStrut", "WoodConnection", "SmallFuelTank", "ExternalFuelTank", "FuelTank", "BigExternalFuelTank", "SmallBalloon", "BigBalloon", "Parachute", "Airbreak", "AirIntake", "AirIntake2", "AirOutlet" },
	Electric = { "SmallBatteries", "BigBatteries", "RotationJoint", "Decoupler", "SolarPanel", "AirTurbine", "Camera", "TempratureFan" },
}

local function v(t: any): Vector3
	return Frames.v(t)
end

function Hangar.new(campaign: any, design: any, originCFrame: CFrame, callbacks: any)
	local self = setmetatable({}, Hangar)
	self.campaign = campaign
	self.design = design
	self.origin = originCFrame
	self.callbacks = callbacks
	self.built = {} :: { [number]: any }
	self.tool = nil :: string?
	self.ghost = nil :: any
	self.ghostMirror = nil :: any
	self.mirrorMode = true
	self.rotation = 0
	self.selected = nil :: number?
	self.undo = {} :: { any }
	self.category = "Cockpits"
	self.connections = {}
	self.camYaw, self.camPitch, self.camDistance = math.rad(140), math.rad(20), 14

	self.folder = Instance.new("Model")
	self.folder.Name = "HangarPlane"
	self.folder.Parent = Workspace

	-- Building platform & grid (BuildingGridVisual)
	local floor = Instance.new("Part")
	floor.Name = "BuildPlatform"
	floor.Anchored = true
	floor.Size = Vector3.new(40, 0.4, 40)
	floor.CFrame = originCFrame * CFrame.new(0, -3.2, 0)
	floor.Color = Color3.fromRGB(70, 74, 80)
	floor.Material = Enum.Material.Concrete
	floor.Transparency = 0.2
	floor.CanQuery = false
	floor.Parent = self.folder
	-- grid lines (BuildingGridVisual)
	for i = -10, 10 do
		for _, axis in { "X", "Z" } do
			local line = Instance.new("Part")
			line.Anchored = true
			line.CanCollide = false
			line.CanQuery = false
			line.Material = Enum.Material.Neon
			line.Color = Color3.fromRGB(150, 160, 170)
			line.Transparency = if i % 5 == 0 then 0.4 else 0.75
			line.Size = if axis == "X" then Vector3.new(40, 0.02, 0.04) else Vector3.new(0.04, 0.02, 40)
			line.CFrame = floor.CFrame * CFrame.new(if axis == "X" then 0 else i * 2, 0.21, if axis == "X" then i * 2 else 0)
			line.Parent = self.folder
		end
	end

	self.highlight = Instance.new("Highlight")
	self.highlight.FillTransparency = 1
	self.highlight.OutlineColor = C.accent
	self.highlight.Parent = Workspace

	for _, e in design.parts do
		self:buildEntry(e)
	end
	self:buildUI()
	self:bindInput()
	self:refresh()
	return self
end

-- ------------------------------------------------------------------------------------------- visuals
function Hangar:buildEntry(e: any)
	local built = PartVisual.create(e.name, self.origin * e.cf, e.flip, e.fuselage, { color = e.color and Color3.new(e.color[1], e.color[2], e.color[3]) or nil })
	built.model:SetAttribute("EntryId", e.id)
	built.model.Parent = self.folder
	self.built[e.id] = built
end

function Hangar:removeVisual(id: number)
	local b = self.built[id]
	if b then
		b.model:Destroy()
		self.built[id] = nil
	end
end

function Hangar:rebuildEntry(e: any)
	self:removeVisual(e.id)
	self:buildEntry(e)
end

-- Snap points of a placed (or candidate) part in design space: { pos, forward, owner }
local function snapPointsFor(name: string, cf: CFrame, flip: boolean, fus: any?): { any }
	local data = Parts[name]
	local out = {}
	if data.procedural then
		local s = fus or Fuselage.default()
		local p1, p2 = Fuselage.endPoints(s)
		table.insert(out, { pos = cf * Frames.localPoint(Vector3.new(-p1.X, p1.Y, p1.Z), flip), forward = cf:VectorToWorldSpace(Vector3.zAxis), localPos = Vector3.new(-p1.X, p1.Y, p1.Z), localForward = Vector3.zAxis })
		table.insert(out, { pos = cf * Frames.localPoint(Vector3.new(-p2.X, p2.Y, p2.Z), flip), forward = cf:VectorToWorldSpace(-Vector3.zAxis), localPos = Vector3.new(-p2.X, p2.Y, p2.Z), localForward = -Vector3.zAxis })
		return out
	end
	for _, sp in data.snapPoints do
		local lp = v(sp.pos)
		table.insert(out, { pos = cf * Frames.localPoint(lp, flip), forward = cf:VectorToWorldSpace(v(sp.forward)), localPos = lp, localForward = v(sp.forward) })
	end
	return out
end

local function collisionPointFor(name: string, fus: any?): any?
	local data = Parts[name]
	if data.procedural then
		local s = fus or Fuselage.default()
		local p1, p2 = Fuselage.endPoints(s)
		local a = p1 - Vector3.new(s.side1.radius.X, 0, 0)
		local b = p2 - Vector3.new(s.side2.radius.X, 0, 0)
		local mid = (a + b) / 2
		-- the attach point sits on the body's side (its unity "right" points into the parent)
		return { pos = Vector3.new(-mid.X, mid.Y, mid.Z), forward = Vector3.new(1, 0, 0), up = Vector3.yAxis }
	end
	if not data.collisionPoint then
		return nil
	end
	return { pos = v(data.collisionPoint.pos), forward = v(data.collisionPoint.forward), up = v(data.collisionPoint.up) }
end

-- Unity forward of a part (BuildingPart.GetForwardOrientation) in design space.
local function forwardOrientation(e: any): Vector3
	local f = v(Parts[e.name].forwardOrientation)
	if f.Magnitude < 0.5 then
		f = Vector3.zAxis
	end
	return e.cf:VectorToWorldSpace(f.Unit)
end

-- ------------------------------------------------------------------------------------------- placement solving
function Hangar:symmetryPlane(): (Vector3, Vector3)
	local base = self.design:basePart()
	if not base then
		return Vector3.zero, Vector3.xAxis
	end
	local b = self.built[base.id]
	local center = base.cf.Position
	if b and #b.visuals > 0 then
		local sum = Vector3.zero
		for _, p in b.visuals do
			sum += self.origin:PointToObjectSpace(p.Position)
		end
		center = sum / #b.visuals
	end
	return center, base.cf.XVector
end

function Hangar:mirrorOf(cf: CFrame, flip: boolean): (CFrame, boolean)
	local center, normal = self:symmetryPlane()
	local pos = cf.Position
	local mpos = pos - normal * (2 * (pos - center):Dot(normal))
	local f = Frames.reflect(cf.ZVector, normal)
	local u = Frames.reflect(cf.YVector, normal)
	return Frames.lookRotation(f, -u, mpos), not flip
end

function Hangar:designRay(): (Vector3, Vector3)
	local mouse = UserInputService:GetMouseLocation()
	local ray = Workspace.CurrentCamera:ViewportPointToRay(mouse.X, mouse.Y)
	return ray.Origin, ray.Direction
end

function Hangar:hitPlane(): (RaycastResult?, number?)
	local origin, dir = self:designRay()
	local include = {}
	for _, b in self.built do
		for _, p in b.visuals do
			table.insert(include, p)
		end
	end
	if #include == 0 then
		return nil, nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = include
	local hit = Workspace:Raycast(origin, dir * 500, params)
	if not hit then
		return nil, nil
	end
	local model = hit.Instance:FindFirstAncestorWhichIsA("Model")
	while model and model:GetAttribute("EntryId") == nil do
		model = model:FindFirstAncestorWhichIsA("Model")
	end
	return hit, model and model:GetAttribute("EntryId")
end

-- Returns cf (design space), flip, parentId or nil when the part can't be placed here.
function Hangar:solve(name: string): (CFrame?, boolean, number?)
	local data = Parts[name]
	local fus = if data.procedural then Fuselage.default() else nil
	if #self.design.parts == 0 then
		if not data.basePart then
			return nil, false, nil
		end
		return CFrame.Angles(0, math.rad(self.rotation), 0), false, nil
	end
	local rayO, rayD = self:designRay()
	-- 1. snap points (SolveSnapping)
	local candidateSnaps = snapPointsFor(name, CFrame.identity, false, fus)
	if #candidateSnaps > 0 then
		local best, bestD = nil, math.huge
		for _, e in self.design.parts do
			local taken = {}
			for _, other in self.design.parts do
				if other.parent == e.id then
					for _, sp in snapPointsFor(other.name, other.cf, other.flip, other.fuselage) do
						table.insert(taken, sp.pos)
					end
				end
			end
			if e.parent then
				local parent = self.design:get(e.parent)
				if parent then
					for _, sp in snapPointsFor(parent.name, parent.cf, parent.flip, parent.fuselage) do
						table.insert(taken, sp.pos)
					end
				end
			end
			for _, target in snapPointsFor(e.name, e.cf, e.flip, e.fuselage) do
				local free = true
				for _, t in taken do
					if (t - target.pos).Magnitude < 0.05 then
						free = false
					end
				end
				if free then
					local worldTarget = self.origin * target.pos
					local toPoint = worldTarget - rayO
					local along = toPoint:Dot(rayD.Unit)
					local d = (toPoint - rayD.Unit * along).Magnitude
					if along > 0 and d < bestD then
						bestD = d
						best = { target = target, owner = e }
					end
				end
			end
		end
		if best and bestD < SNAP_DISTANCE * 1.5 then
			-- choose the candidate snap point that faces the target best
			local own = candidateSnaps[1]
			local rot = Frames.fromToRotation(own.localForward, -best.target.forward)
			local spin = CFrame.fromAxisAngle(own.localForward, math.rad(self.rotation))
			local r = rot * spin
			local pos = best.target.pos - r * own.localPos
			local cf = r + pos
			if data.tryOrientUpwards then
				cf = Frames.lookRotation(cf.ZVector, Vector3.yAxis, cf.Position)
			end
			if data.tryMatchParentRotation then
				cf = Frames.lookRotation(cf.ZVector, best.owner.cf.YVector, cf.Position)
			end
			return cf, false, best.owner.id
		end
	end
	-- 2. surface attach via the collision point
	local cp = collisionPointFor(name, fus)
	if not cp then
		return nil, false, nil
	end
	local hit, ownerId = self:hitPlane()
	if not hit or not ownerId then
		return nil, false, nil
	end
	local owner = self.design:get(ownerId)
	if not owner then
		return nil, false, nil
	end
	local normalW = hit.Normal
	local normal = self.origin:VectorToObjectSpace(normalW)
	local point = self.origin:PointToObjectSpace(hit.Position)
	local lhs = forwardOrientation(owner)
	local planeForward = Vector3.zAxis
	if lhs:Dot(planeForward) < -0.99 and Parts[owner.name].symetrical then
		lhs = planeForward
	end
	-- Unity: Cross(lhs, normal) used as the attach point's up; mirrored space flips the cross product.
	local snapped = Vector3.new(MathUtil.snapToIncrement(normal.X, 1), MathUtil.snapToIncrement(normal.Y, 1), MathUtil.snapToIncrement(normal.Z, 1))
	if snapped.Magnitude < 0.5 then
		snapped = normal
	end
	snapped = snapped.Unit
	local up = snapped:Cross(lhs)
	if up.Magnitude < 1e-3 then
		up = snapped:Cross(if math.abs(snapped.Y) < 0.9 then Vector3.yAxis else Vector3.xAxis)
	end
	-- Rotation that puts the attach point's forward into the surface and its up along `up`.
	local target = Frames.lookRotation(-snapped, up.Unit)
	local localCP = Frames.lookRotation(cp.forward, cp.up)
	local base = target * localCP:Inverse()
	local spin = CFrame.fromAxisAngle(cp.forward, math.rad(self.rotation))
	local rot = base * spin
	local flip = false
	local pos = point - rot * cp.pos
	-- snap onto the symmetry plane when very close
	local center, n = self:symmetryPlane()
	local dist = (pos - center):Dot(n)
	if math.abs(dist) < 0.075 then
		pos -= n * dist
	end
	if data.flipSymmetry then
		local side = lhs:Cross(Vector3.yAxis)
		local toParent = (owner.cf.Position - pos)
		flip = side:Dot(toParent) > 0
	end
	return rot + pos, flip, owner.id
end

-- ------------------------------------------------------------------------------------------- tools
function Hangar:setTool(name: string?)
	self.tool = name
	self.selected = nil
	self:clearGhost()
	if name then
		self.ghost = PartVisual.create(name, CFrame.new(0, -1000, 0), false, if Parts[name].procedural then Fuselage.default() else nil)
		for _, p in self.ghost.visuals do
			p.Transparency = math.max(p.Transparency, 0.45)
			p.CanQuery = false
		end
		self.ghost.model.Parent = Workspace
		self.ghostMirror = PartVisual.create(name, CFrame.new(0, -1000, 0), true, if Parts[name].procedural then Fuselage.default() else nil)
		for _, p in self.ghostMirror.visuals do
			p.Transparency = math.max(p.Transparency, 0.6)
			p.CanQuery = false
		end
		self.ghostMirror.model.Parent = Workspace
	end
	self:refresh()
end

function Hangar:clearGhost()
	if self.ghost then
		self.ghost.model:Destroy()
		self.ghost = nil
	end
	if self.ghostMirror then
		self.ghostMirror.model:Destroy()
		self.ghostMirror = nil
	end
	self.ghostFlip = nil
end

local function moveBuilt(built: any, name: string, cf: CFrame, flip: boolean)
	-- rebuilding is simplest and robust to flips; ghosts are cheap (a handful of pieces)
	local data = Parts[name]
	local i = 0
	for _, node in data.nodes do
		i += 1
		local piece = built.visuals[i]
		if piece then
			piece.CFrame = cf * CFrame.new(Frames.localPoint(v(node.center), flip))
		end
	end
	if data.procedural then
		built.model:PivotTo(cf)
	end
end

function Hangar:updateGhost()
	if not self.tool or not self.ghost then
		return
	end
	local cf, flip, _ = self:solve(self.tool)
	local data = Parts[self.tool]
	if not cf then
		self.ghost.model:PivotTo(CFrame.new(0, -1000, 0))
		self.ghostMirror.model:PivotTo(CFrame.new(0, -1000, 0))
		self.pending = nil
		return
	end
	if data.procedural then
		self.ghost.model:PivotTo(self.origin * cf)
	else
		moveBuilt(self.ghost, self.tool, self.origin * cf, flip)
	end
	local pending = { cf = cf, flip = flip }
	if self.mirrorMode and #self.design.parts > 0 then
		local center, n = self:symmetryPlane()
		if math.abs((cf.Position - center):Dot(n)) > 0.08 then
			local mcf, mflip = self:mirrorOf(cf, flip)
			if data.procedural then
				self.ghostMirror.model:PivotTo(self.origin * mcf)
			else
				moveBuilt(self.ghostMirror, self.tool, self.origin * mcf, mflip)
			end
			pending.mirror = { cf = mcf, flip = mflip }
		else
			self.ghostMirror.model:PivotTo(CFrame.new(0, -1000, 0))
		end
	else
		self.ghostMirror.model:PivotTo(CFrame.new(0, -1000, 0))
	end
	self.pending = pending
end

function Hangar:priceOf(name: string, fus: any?): number
	return PlaneDesign.partStats({ name = name, fuselage = fus }).price
end

function Hangar:place()
	local name = self.tool
	if not name then
		return
	end
	local cf, flip, parentId = self:solve(name)
	if not cf then
		UI.toast(self.gui, if #self.design.parts == 0 then "Start with a cockpit or a body" else "Point at the plane to attach this part", C.bad)
		return
	end
	if not self.campaign:isUnlocked(name) then
		UI.toast(self.gui, "Research this part first", C.bad)
		return
	end
	local fus = if Parts[name].procedural then Fuselage.default() else nil
	local count = if self.pending and self.pending.mirror then 2 else 1
	local price = self:priceOf(name, fus) * count
	if not self.campaign:hasMoney(price) then
		UI.toast(self.gui, "Not enough money", C.bad)
		return
	end
	self.campaign:changeMoney(-price)
	local e = self.design:add({ name = name, cf = cf, flip = flip, parent = parentId, fuselage = fus })
	self:buildEntry(e)
	local added = { e }
	if self.pending and self.pending.mirror then
		local m = self.design:add({ name = name, cf = self.pending.mirror.cf, flip = self.pending.mirror.flip, parent = parentId, fuselage = fus and Fuselage.copy(fus), mirror = e.id })
		e.mirror = m.id
		self:buildEntry(m)
		table.insert(added, m)
		-- the mirrored part attaches to the mirrored parent when there is one
		local parent = parentId and self.design:get(parentId)
		if parent and parent.mirror then
			m.parent = parent.mirror
		end
	end
	table.insert(self.undo, { kind = "place", ids = { e.id, added[2] and added[2].id or nil }, price = price })
	self:refresh()
end

function Hangar:deleteSelected()
	local id = self.selected
	if not id then
		return
	end
	local removed = self.design:remove(id, self.mirrorMode)
	local refund = 0
	for _, r in removed do
		refund += PlaneDesign.partStats(r).price
		self:removeVisual(r.id)
	end
	self.campaign:changeMoney(refund)
	table.insert(self.undo, { kind = "remove", entries = removed, price = refund })
	self.selected = nil
	self:refresh()
end

function Hangar:undoLast()
	local u = table.remove(self.undo)
	if not u then
		return
	end
	if u.kind == "place" then
		for _, id in u.ids do
			if id then
				for _, r in self.design:remove(id, false) do
					self:removeVisual(r.id)
				end
			end
		end
		self.campaign:changeMoney(u.price)
	elseif u.kind == "remove" then
		if not self.campaign:hasMoney(u.price) then
			UI.toast(self.gui, "Not enough money to undo", C.bad)
			table.insert(self.undo, u)
			return
		end
		self.campaign:changeMoney(-u.price)
		for _, e in u.entries do
			table.insert(self.design.parts, e)
			self:buildEntry(e)
		end
	end
	self.selected = nil
	self:refresh()
end

-- Body resizing (ProceduralFuselage gizmos), with the price difference charged or refunded.
function Hangar:resizeBody(id: number, change: (any) -> ())
	local e = self.design:get(id)
	if not e or not Parts[e.name].procedural then
		return
	end
	local entries = { e }
	if e.mirror and self.design:get(e.mirror) then
		table.insert(entries, self.design:get(e.mirror))
	end
	local before = 0
	for _, x in entries do
		before += PlaneDesign.partStats(x).price
	end
	local new = Fuselage.copy(e.fuselage or Fuselage.default())
	change(new)
	-- keep sizes sensible
	for _, side in { new.side1, new.side2 } do
		side.radius = Vector2.new(math.clamp(side.radius.X, 0.15, 4), math.clamp(side.radius.Y, 0.15, 4))
		side.lengthOffset = Vector3.new(side.lengthOffset.X, side.lengthOffset.Y, math.clamp(side.lengthOffset.Z, 0.1, 12))
		for i = 1, 4 do
			side.roundness[i] = math.clamp(side.roundness[i], 0, 1)
		end
	end
	local after = 0
	for _, x in entries do
		after += PlaneDesign.partStats({ name = x.name, fuselage = new }).price
	end
	if after > before and not self.campaign:hasMoney(after - before) then
		UI.toast(self.gui, "Not enough money", C.bad)
		return
	end
	self.campaign:changeMoney(before - after)
	for _, x in entries do
		x.fuselage = Fuselage.copy(new)
		self:rebuildEntry(x)
	end
	self:refresh()
end

-- ------------------------------------------------------------------------------------------- UI
function Hangar:buildUI()
	local gui = UI.screen("Hangar", 4)
	self.gui = gui
	-- top bar
	local top = UI.panel({ Size = UDim2.new(0, 0, 0, 44), AutomaticSize = Enum.AutomaticSize.X, Position = UDim2.new(0, 16, 0, 16), Parent = gui })
	UI.padding(10).Parent = top
	UI.list(Enum.FillDirection.Horizontal, 18).Parent = top
	self.moneyLabel = UI.label("", 20, { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), Font = UI.FontBold, Parent = top })
	self.scrapLabel = UI.label("", 18, { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), Parent = top })

	-- part palette (bottom)
	local palette = UI.panel({ Size = UDim2.new(1, -420, 0, 170), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -16), Parent = gui })
	UI.padding(10).Parent = palette
	local tabs = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), Parent = palette })
	UI.list(Enum.FillDirection.Horizontal, 6).Parent = tabs
	self.tabButtons = {}
	for i, cat in CATEGORIES do
		local b = UI.button(CATEGORY_TITLES[cat], function()
			self.category = cat
			self:refresh()
		end, { Size = UDim2.new(0, 100, 0, 30), LayoutOrder = i, Parent = tabs })
		self.tabButtons[cat] = b
	end
	local scroll = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -40),
		Position = UDim2.new(0, 0, 0, 40),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 6,
		Parent = palette,
	})
	UI.list(Enum.FillDirection.Horizontal, 8).Parent = scroll
	self.partList = scroll

	-- stats (right)
	local stats = UI.panel({ Size = UDim2.new(0, 380, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Parent = gui })
	UI.padding(12).Parent = stats
	UI.list(nil, 4).Parent = stats
	UI.label("PLANE", 12, { TextColor3 = C.accent, Font = UI.FontBold, LayoutOrder = 0, Parent = stats })
	self.statsLabel = UI.label("", 15, { AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 1, Parent = stats })
	self.selPanel = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = stats })
	UI.list(nil, 6).Parent = self.selPanel

	-- toolbar (bottom right)
	local bar = UI.panel({ Size = UDim2.new(0, 380, 0, 170), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Parent = gui })
	UI.padding(10).Parent = bar
	local grid = UI.new("UIGridLayout", { CellSize = UDim2.new(0, 112, 0, 40), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = bar })
	local _ = grid
	self.mirrorButton = UI.button("Mirror: on", function()
		self.mirrorMode = not self.mirrorMode
		self:refresh()
	end, { LayoutOrder = 1, Parent = bar })
	UI.button("Rotate (R)", function()
		self.rotation = (self.rotation + 45) % 360
	end, { LayoutOrder = 2, Parent = bar })
	UI.button("Undo", function()
		self:undoLast()
	end, { LayoutOrder = 3, Parent = bar })
	UI.button("Research", function()
		self:openResearch()
	end, { LayoutOrder = 4, Parent = bar })
	UI.button("Designs", function()
		self.callbacks.designs()
	end, { LayoutOrder = 5, Parent = bar })
	UI.button("Controls", function()
		UI.modal("Controls", UI.ControlsText)
	end, { LayoutOrder = 6, Parent = bar })
	self.flyButton = UI.button("<b>FLY ✈</b>", function()
		self.callbacks.fly()
	end, { LayoutOrder = 7, BackgroundColor3 = C.accent, TextColor3 = C.text, Parent = bar })
	UI.button("Menu", function()
		self.callbacks.menu()
	end, { LayoutOrder = 8, Parent = bar })
end

function Hangar:partButton(name: string, order: number)
	local data = Parts[name]
	if not data then
		return
	end
	local unlocked = self.campaign:isUnlocked(name)
	local price = self:priceOf(name, if data.procedural then Fuselage.default() else nil)
	local c1, c2 = (require(Shared.Campaign) :: any).researchCost(name)
	local text = "<b>" .. (data.displayName or name) .. "</b>\n💰 " .. math.floor(price + 0.5)
	if not unlocked then
		text = "<b>" .. (data.displayName or name) .. "</b>\n🔒 ⚙" .. c1 .. (if c2 > 0 then " ✦" .. c2 else "")
	end
	local b = UI.button(text, function()
		if not unlocked then
			self:openResearch(name)
			return
		end
		if self.tool == name then
			self:setTool(nil)
		else
			self:setTool(name)
		end
	end, {
		Size = UDim2.new(0, 120, 0, 110),
		TextSize = 14,
		TextWrapped = true,
		LayoutOrder = order,
		BackgroundColor3 = if self.tool == name then C.accent elseif unlocked then C.panelLight else Color3.fromRGB(120, 120, 125),
		TextColor3 = if self.tool == name then C.text else C.textDark,
		Parent = self.partList,
	})
	return b
end

function Hangar:refresh()
	local campaign = self.campaign
	self.moneyLabel.Text = "💰 " .. MathUtil.formatNumber(campaign.money)
	self.scrapLabel.Text = "⚙ " .. campaign.scrap .. "   ✦ " .. campaign.advancedScrap
	for cat, b in self.tabButtons do
		b.BackgroundColor3 = if cat == self.category then C.accent else C.panelLight
		b.TextColor3 = if cat == self.category then C.text else C.textDark
	end
	for _, c in self.partList:GetChildren() do
		if c:IsA("GuiButton") then
			c:Destroy()
		end
	end
	for i, name in ORDER[self.category] do
		if Parts[name] then
			self:partButton(name, i)
		end
	end
	self.mirrorButton.Text = "Mirror: " .. (if self.mirrorMode then "on" else "off")

	local s = self.design:stats()
	local lines = {
		string.format("Parts: %d   Value: 💰%d", s.parts, math.floor(s.cost + 0.5)),
		string.format("Weight: %.1f t", s.weight),
		string.format("Thrust: %.0f  (thrust/weight %.2f)", s.thrust, if s.weight > 0 then s.thrust / (s.weight / 15 * 25.5) else 0),
		string.format("Lift: %d", math.floor(s.lift + 0.5)),
		string.format("Fuel: %d   Battery: %.2f   Cargo space: %d", math.floor(s.fuel + 1.5), s.battery, math.floor(s.cargo + 0.5)),
	}
	local warnings = {}
	if s.parts == 0 then
		table.insert(warnings, "Start with a cockpit or a body.")
	else
		if not s.hasEngine then
			table.insert(warnings, "No engine.")
		end
		if not s.hasWing then
			table.insert(warnings, "No wings (fine for helicopters and balloons).")
		end
		if not s.hasWheel then
			table.insert(warnings, "No wheels.")
		end
	end
	if #warnings > 0 then
		table.insert(lines, '<font color="#E0A040">' .. table.concat(warnings, " ") .. "</font>")
	end
	self.statsLabel.Text = table.concat(lines, "\n")
	self:refreshSelection()
end

function Hangar:refreshSelection()
	for _, c in self.selPanel:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local e = self.selected and self.design:get(self.selected)
	if not e then
		self.highlight.Adornee = nil
		return
	end
	local b = self.built[e.id]
	self.highlight.Adornee = b and b.model or nil
	local data = Parts[e.name]
	local ps = PlaneDesign.partStats(e)
	UI.label("SELECTED", 12, { TextColor3 = C.accent, Font = UI.FontBold, Parent = self.selPanel })
	UI.label(string.format("<b>%s</b>  · %.2f t · 💰%d", data.displayName or e.name, ps.weight, math.floor(ps.price + 0.5)), 15, { Parent = self.selPanel })
	UI.button("Remove (Del)", function()
		self:deleteSelected()
	end, { BackgroundColor3 = C.bad, TextColor3 = C.text, Parent = self.selPanel })
	if data.procedural then
		local id = e.id
		local function row(label: string, f: (any, number) -> ())
			local r = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), Parent = self.selPanel })
			UI.label(label, 14, { Size = UDim2.new(1, -110, 1, 0), Parent = r })
			UI.button("−", function()
				self:resizeBody(id, function(s)
					f(s, -1)
				end)
			end, { Size = UDim2.new(0, 50, 0, 28), Position = UDim2.new(1, -106, 0, 1), Parent = r })
			UI.button("+", function()
				self:resizeBody(id, function(s)
					f(s, 1)
				end)
			end, { Size = UDim2.new(0, 50, 0, 28), Position = UDim2.new(1, -52, 0, 1), Parent = r })
		end
		row("Length (front)", function(s, d)
			s.side1.lengthOffset += Vector3.new(0, 0, 0.25 * d)
		end)
		row("Length (back)", function(s, d)
			s.side2.lengthOffset += Vector3.new(0, 0, 0.25 * d)
		end)
		row("Width (front / back)", function(s, d)
			s.side1.radius += Vector2.new(0.1 * d, 0)
			s.side2.radius += Vector2.new(0.1 * d, 0)
		end)
		row("Height (front / back)", function(s, d)
			s.side1.radius += Vector2.new(0, 0.1 * d)
			s.side2.radius += Vector2.new(0, 0.1 * d)
		end)
		row("Front size (taper)", function(s, d)
			s.side1.radius += Vector2.new(0.1 * d, 0.1 * d)
		end)
		row("Back size (taper)", function(s, d)
			s.side2.radius += Vector2.new(0.1 * d, 0.1 * d)
		end)
		row("Roundness", function(s, d)
			for i = 1, 4 do
				s.side1.roundness[i] += 0.25 * d
				s.side2.roundness[i] += 0.25 * d
			end
		end)
	end
end

-- ResearchPanel: unlock parts with scrap (⚙) and advanced scrap (✦).
function Hangar:openResearch(focusPart: string?)
	if self.researchGui then
		self.researchGui:Destroy()
	end
	local gui = UI.screen("Research", 15)
	self.researchGui = gui
	local frame = UI.panel({ Size = UDim2.new(0.75, 0, 0.75, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Parent = gui })
	UI.padding(16).Parent = frame
	UI.label("RESEARCH — ⚙ " .. self.campaign.scrap .. "   ✦ " .. self.campaign.advancedScrap, 20, { Font = UI.FontBold, Parent = frame })
	UI.button("Close", function()
		gui:Destroy()
		self.researchGui = nil
	end, { Position = UDim2.new(1, -140, 0, 0), Parent = frame })
	local scroll = UI.new("ScrollingFrame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -50), Position = UDim2.new(0, 0, 0, 50), AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 6, Parent = frame })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0, 170, 0, 96), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	local items = table.clone(Research)
	table.sort(items, function(a, b)
		if a.x ~= b.x then
			return a.x < b.x
		end
		return a.y < b.y
	end)
	for i, item in items do
		local name = item.part
		if name and Parts[name] then
			local unlocked = self.campaign:isUnlocked(name)
			local data = Parts[name]
			local text = "<b>" .. (data.displayName or name) .. "</b>\n" .. (if unlocked then "Unlocked ✓" else "⚙ " .. item.cost1 .. (if item.cost2 > 0 then "   ✦ " .. item.cost2 else ""))
			UI.button(text, function()
				if unlocked then
					return
				end
				if self.campaign:unlock(name) then
					UI.toast(gui, (data.displayName or name) .. " unlocked!", C.good)
					self:openResearch()
					self:refresh()
					self.callbacks.changed()
				else
					UI.toast(gui, "Not enough scrap. Deliver cargo and collect scrap to earn more.", C.bad)
				end
			end, {
				LayoutOrder = i,
				TextWrapped = true,
				TextSize = 14,
				BackgroundColor3 = if unlocked then C.good elseif name == focusPart then C.accent else C.panelLight,
				TextColor3 = if unlocked or name == focusPart then C.text else C.textDark,
				Parent = scroll,
			})
		end
	end
end

-- ------------------------------------------------------------------------------------------- input & camera
function Hangar:bindInput()
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	local dragging = false
	table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			dragging = true
		end
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if self.tool then
				self:place()
			else
				local _, id = self:hitPlane()
				self.selected = id
				self:refresh()
			end
		elseif input.KeyCode == Enum.KeyCode.R then
			self.rotation = (self.rotation + 45) % 360
		elseif input.KeyCode == Enum.KeyCode.T then
			self.rotation = (self.rotation - 45) % 360
		elseif input.KeyCode == Enum.KeyCode.X then
			self.mirrorMode = not self.mirrorMode
			self:refresh()
		elseif input.KeyCode == Enum.KeyCode.Delete or input.KeyCode == Enum.KeyCode.Backspace then
			self:deleteSelected()
		elseif input.KeyCode == Enum.KeyCode.Z and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
			self:undoLast()
		elseif input.KeyCode == Enum.KeyCode.Escape then
			self:setTool(nil)
		end
	end))
	table.insert(self.connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			dragging = false
		end
	end))
	table.insert(self.connections, UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
			self.camYaw -= input.Delta.X * 0.008
			self.camPitch = math.clamp(self.camPitch + input.Delta.Y * 0.008, -1.2, 1.4)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			self.camDistance = math.clamp(self.camDistance * (1 - input.Position.Z * 0.1), 3, 80)
		elseif input.UserInputType == Enum.UserInputType.Touch and dragging then
			self.camYaw -= input.Delta.X * 0.008
		end
	end))
	table.insert(self.connections, RunService.RenderStepped:Connect(function()
		UserInputService.MouseBehavior = if dragging then Enum.MouseBehavior.LockCurrentPosition else Enum.MouseBehavior.Default
		local focus = self.origin.Position
		local n = 0
		local sum = Vector3.zero
		for _, b in self.built do
			for _, p in b.visuals do
				sum += p.Position
				n += 1
			end
		end
		if n > 0 then
			focus = sum / n
		end
		local offset = CFrame.Angles(0, self.camYaw, 0) * CFrame.Angles(-self.camPitch, 0, 0) * Vector3.new(0, 0, self.camDistance)
		camera.CFrame = CFrame.lookAt(focus + offset, focus)
		self:updateGhost()
	end))
end

function Hangar:destroy()
	for _, c in self.connections do
		c:Disconnect()
	end
	self:clearGhost()
	if self.researchGui then
		self.researchGui:Destroy()
	end
	self.gui:Destroy()
	self.highlight:Destroy()
	self.folder:Destroy()
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
end

return Hangar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">PartVisual</string>
              <string name="Source"><![CDATA[--!strict
-- Builds the Roblox instances for one placed part: imported meshes (or coloured stand-in blocks when the meshes
-- have not been imported yet), invisible physics colliders, and the procedural fuselage for "Body".
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Parts = require(Shared.Data.Parts)
local Fuselage = require(Shared.Fuselage)
local Frames = require(script.Parent.Frames)
local Triangles = require(script.Parent.Triangles)

local PartVisual = {}

-- Name of the folder (anywhere under ReplicatedStorage) holding the models imported from the .glb files.
PartVisual.MeshFolderName = "AviassemblyMeshes"
-- If Studio's importer turned the meshes around, set a correction here (applied to every imported mesh).
PartVisual.MeshRotationFix = CFrame.identity

local meshIndex: { [string]: MeshPart }? = nil
local missingWarned = false

function PartVisual.refreshMeshIndex()
	local index: { [string]: MeshPart } = {}
	for _, d in ReplicatedStorage:GetDescendants() do
		if d:IsA("MeshPart") then
			index[d.Name] = d
		end
	end
	meshIndex = index
	return index
end

function PartVisual.findMesh(name: string): MeshPart?
	local index = meshIndex or PartVisual.refreshMeshIndex()
	return index[name]
end

function PartVisual.hasImportedMeshes(): boolean
	local index = meshIndex or PartVisual.refreshMeshIndex()
	return next(index) ~= nil
end

local function color(t: { number }?): Color3
	if not t then
		return Color3.fromRGB(220, 220, 220)
	end
	return Color3.new(t[1], t[2], t[3])
end

-- Creates a visual for one exported mesh piece (part node or airport chunk).
function PartVisual.meshPiece(node: any, worldCFrame: CFrame, parent: Instance): BasePart
	local source = PartVisual.findMesh(node.name)
	local piece: BasePart
	if source then
		local m = source:Clone()
		m.Size = Vector3.new(node.size[1], node.size[2], node.size[3])
		piece = m
		worldCFrame = worldCFrame * PartVisual.MeshRotationFix
	else
		if not missingWarned then
			missingWarned = true
			warn("[Aviassembly] Imported meshes not found under ReplicatedStorage." .. PartVisual.MeshFolderName .. " - using stand-in blocks. See README (Importing your models).")
		end
		local p = Instance.new("Part")
		p.Size = Vector3.new(math.max(node.size[1], 0.05), math.max(node.size[2], 0.05), math.max(node.size[3], 0.05))
		p.Color = color(node.color)
		p.Material = Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		piece = p
	end
	piece.Name = node.name
	piece.Transparency = math.clamp(1 - (node.alpha or 1), 0, 0.85)
	piece.CFrame = worldCFrame
	piece.Anchored = true
	piece.CanCollide = false
	piece.CanTouch = false
	piece.CanQuery = true
	piece.Massless = true
	piece.Parent = parent
	return piece
end

export type Built = {
	model: Model,
	visuals: { BasePart },
	colliders: { BasePart },
	spinners: { { part: BasePart, axis: Vector3 } },
}

local BODY_COLOR = Color3.new(0.915, 0.915, 0.915)

local function buildFuselage(settings: any, cf: CFrame, flip: boolean, model: Model, built: Built, bodyColor: Color3?)
	local tris = Fuselage.triangles(settings)
	local centerLocal = Vector3.zero
	for _, t in tris do
		local pts = {}
		for i, p in t do
			-- Unity part space -> mirrored Roblox part space -> world
			pts[i] = Frames.worldPoint(cf, flip, Vector3.new(-p.X, p.Y, p.Z))
		end
		local centroid = (pts[1] + pts[2] + pts[3]) / 3
		local outward = centroid - cf * centerLocal
		local w1, w2 = Triangles.draw(pts[1], pts[2], pts[3], { color = bodyColor or BODY_COLOR, thickness = 0.03, outward = outward, parent = model })
		for _, w in { w1, w2 } do
			if w then
				w.Massless = true
				w.CanQuery = true
				table.insert(built.visuals, w)
			end
		end
	end
	-- Collider: the box around the loft.
	local s = settings
	local w = math.max(s.side1.radius.X, s.side2.radius.X) * 2
	local h = math.max(s.side1.radius.Y, s.side2.radius.Y) * 2
	local p1, p2 = Fuselage.endPoints(s)
	local mid = (p1 + p2) / 2
	local len = math.max(math.abs(p1.Z - p2.Z), 0.1)
	local box = Instance.new("Part")
	box.Name = "Collider"
	box.Size = Vector3.new(w, h, len)
	box.CFrame = cf * CFrame.new(Frames.localPoint(Vector3.new(-mid.X, mid.Y, mid.Z), flip))
	table.insert(built.colliders, box)
end

-- Build the instances for a part placed at `cf` (port convention, see Frames). Everything is created anchored;
-- Flight unanchors and welds them.
function PartVisual.create(partName: string, cf: CFrame, flip: boolean, fuselageSettings: any?, opts: { color: Color3? }?): Built
	local data = Parts[partName]
	assert(data, "unknown part " .. tostring(partName))
	local model = Instance.new("Model")
	model.Name = partName
	local built: Built = { model = model, visuals = {}, colliders = {}, spinners = {} }

	if data.procedural then
		buildFuselage(fuselageSettings or Fuselage.default(), cf, flip, model, built, opts and opts.color)
	end

	local spinPath = data.propeller and data.propeller.path
	local spinAxis = Vector3.xAxis
	for _, comp in data.components do
		if comp.type == "Engine" then
			local f = comp.frame
			spinAxis = if comp.data.helicopterRotor == 1 then Frames.v(f.up) else Frames.v(f.right)
		end
	end
	for _, node in data.nodes do
		local center = Frames.localPoint(Frames.v(node.center), flip)
		local piece = PartVisual.meshPiece(node, cf * CFrame.new(center), model)
		table.insert(built.visuals, piece)
		if spinPath and node.path and (node.path == spinPath or string.sub(node.path, 1, #spinPath + 1) == spinPath .. "/") then
			table.insert(built.spinners, { part = piece, axis = spinAxis })
		end
	end

	for _, c in data.colliders do
		if c.active then
			local part: BasePart
			if c.shape == "ball" then
				local b = Instance.new("Part")
				b.Shape = Enum.PartType.Ball
				part = b
			else
				part = Instance.new("Part")
			end
			part.Name = "Collider"
			part.Size = Vector3.new(math.max(c.size[1], 0.05), math.max(c.size[2], 0.05), math.max(c.size[3], 0.05))
			local center = Frames.localPoint(Frames.v(c.center), flip)
			local right, up = Frames.v(c.right), Frames.v(c.up)
			local z = right:Cross(up)
			if z.Magnitude < 1e-6 then
				z = Vector3.zAxis
			end
			part.CFrame = cf * CFrame.fromMatrix(center, right.Unit, up.Unit, z.Unit)
			table.insert(built.colliders, part)
		end
	end
	for _, c in built.colliders do
		c.Transparency = 1
		c.Anchored = true
		c.CanCollide = false
		c.CanTouch = false
		c.CanQuery = false
		c.Parent = model
	end
	model:SetAttribute("PartName", partName)
	model.WorldPivot = cf
	return built
end

function PartVisual.setColor(built: Built, color: Color3)
	for _, v in built.visuals do
		if not v:IsA("MeshPart") or v.TextureID == "" then
			v.Color = color
		end
	end
end

return PartVisual
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">PlaneDesign</string>
              <string name="Source"><![CDATA[--!strict
-- A plane design: the list of placed parts (in design space), their parent/child links and mirror pairs.
-- Mirrors PlaneStorage / PartContainer from the original.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Parts = require(Shared.Data.Parts)
local Fuselage = require(Shared.Fuselage)
local Frames = require(script.Parent.Frames)

local PlaneDesign = {}
PlaneDesign.__index = PlaneDesign

export type Entry = {
	id: number,
	name: string,
	cf: CFrame,
	flip: boolean,
	parent: number?,
	mirror: number?,
	fuselage: any?,
	color: { number }?,
}

function PlaneDesign.new()
	local self = setmetatable({}, PlaneDesign)
	self.parts = {} :: { Entry }
	self.nextId = 1
	return self
end

function PlaneDesign:get(id: number): Entry?
	for _, e in self.parts do
		if e.id == id then
			return e
		end
	end
	return nil
end

function PlaneDesign:add(e: any): Entry
	e.id = self.nextId
	self.nextId += 1
	table.insert(self.parts, e)
	return e
end

function PlaneDesign:children(id: number): { Entry }
	local out = {}
	for _, e in self.parts do
		if e.parent == id then
			table.insert(out, e)
		end
	end
	return out
end

-- Removes a part, everything attached to it, and (optionally) the mirrored copies. Returns removed entries.
function PlaneDesign:remove(id: number, withMirror: boolean?): { Entry }
	local removed = {}
	local function rec(pid: number)
		for _, c in self:children(pid) do
			rec(c.id)
		end
		for i, e in self.parts do
			if e.id == pid then
				table.insert(removed, table.remove(self.parts, i))
				break
			end
		end
	end
	local e = self:get(id)
	if not e then
		return removed
	end
	local mirror = e.mirror
	rec(id)
	if withMirror and mirror and self:get(mirror) then
		for _, r in self:remove(mirror, false) do
			table.insert(removed, r)
		end
	end
	return removed
end

function PlaneDesign:basePart(): Entry?
	for _, e in self.parts do
		if e.parent == nil then
			return e
		end
	end
	return nil
end

-- Per-part derived stats (Body scales with its volume).
function PlaneDesign.partStats(e: Entry)
	local data = Parts[e.name]
	local weight, price, cargo = data.weight, data.price, 0
	for _, c in data.components do
		if c.type == "Fuselage" then
			cargo += math.abs(c.data.cargoVolume or 0)
		end
	end
	if data.procedural and e.fuselage then
		local s = Fuselage.stats(e.fuselage, cargo, weight, price)
		weight, price, cargo = s.weight, s.price, s.cargoVolume
	end
	return { weight = weight, price = price, cargo = cargo }
end

function PlaneDesign:cost(): number
	local total = 0
	for _, e in self.parts do
		total += PlaneDesign.partStats(e).price
	end
	return total
end

-- Summary stats for the hangar UI (PlaneStats / BuildingPartTooltip).
function PlaneDesign:stats()
	local s = { weight = 0, fuel = 0, battery = 0, cargo = 0, thrust = 0, lift = 0, parts = #self.parts, hasEngine = false, hasWing = false, hasWheel = false, cost = 0 }
	for _, e in self.parts do
		local ps = PlaneDesign.partStats(e)
		s.weight += ps.weight
		s.cargo += ps.cargo
		s.cost += ps.price
		for _, c in Parts[e.name].components do
			local d = c.data
			if c.type == "FuelTank" then
				s.fuel += math.abs(d.volume or 0)
			elseif c.type == "Wing" then
				s.fuel += math.abs(d.fuel or 0)
				s.lift += (d.liftForce or 0) * d.area[1] * d.area[2] * 10000
				s.hasWing = true
			elseif c.type == "Battery" then
				s.battery += math.abs(d.capacity or 0)
			elseif c.type == "Engine" then
				s.thrust += if d.useAfterburner == 1 then d.afterburnerThrust else d.thrust
				s.hasEngine = true
			elseif c.type == "Wheel" then
				s.hasWheel = true
			end
		end
	end
	return s
end

-- ---------------------------------------------------------------------------------------------- serialisation
function PlaneDesign:serialize(): any
	local out = { v = 1, parts = {} }
	for _, e in self.parts do
		table.insert(out.parts, {
			i = e.id,
			n = e.name,
			c = Frames.encodeCFrame(e.cf),
			f = e.flip,
			p = e.parent,
			m = e.mirror,
			b = if e.fuselage then Fuselage.encode(e.fuselage) else nil,
			col = e.color,
		})
	end
	return out
end

function PlaneDesign.deserialize(data: any)
	local self = PlaneDesign.new()
	if type(data) ~= "table" or type(data.parts) ~= "table" then
		return self
	end
	for _, p in data.parts do
		if Parts[p.n] then
			table.insert(self.parts, {
				id = p.i,
				name = p.n,
				cf = Frames.decodeCFrame(p.c),
				flip = p.f == true,
				parent = p.p,
				mirror = p.m,
				fuselage = if p.b then Fuselage.decode(p.b) else nil,
				color = p.col,
			})
			self.nextId = math.max(self.nextId, p.i + 1)
		end
	end
	return self
end

return PlaneDesign
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">Triangles</string>
              <string name="Source"><![CDATA[--!strict
-- Draws arbitrary triangles with two WedgeParts each (the standard Roblox technique). Used for the procedural
-- fuselage and the low-poly terrain. `outward` picks which side of the triangle is the visible surface; the
-- wedges are pushed `thickness` behind it.
local Triangles = {}

local function makeWedge(template: WedgePart?): WedgePart
	local w = if template then template:Clone() else Instance.new("WedgePart")
	w.Anchored = true
	w.CanCollide = false
	w.CanTouch = false
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	w.CastShadow = true
	return w
end

export type Props = {
	color: Color3,
	material: Enum.Material?,
	thickness: number?,
	outward: Vector3?, -- preferred normal direction of the visible face
	parent: Instance,
	anchored: boolean?,
	canCollide: boolean?,
	canQuery: boolean?,
	transparency: number?,
	template: WedgePart?,
}

-- Returns the two wedges (or nothing for degenerate triangles).
function Triangles.draw(a: Vector3, b: Vector3, c: Vector3, props: Props): (WedgePart?, WedgePart?)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local cross = ac:Cross(ab)
	if cross.Magnitude < 1e-7 or bc.Magnitude < 1e-6 then
		return nil, nil
	end
	local right = cross.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	if height < 1e-4 then
		return nil, nil
	end
	local thickness = props.thickness or 0.05
	local outward = props.outward
	local normal = right
	if outward and normal:Dot(outward) < 0 then
		normal = -normal
	end
	local offset = -normal * (thickness / 2)

	local w1 = makeWedge(props.template)
	w1.Size = Vector3.new(thickness, height, math.abs(ab:Dot(back)))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2 + offset, right, up, back)
	local w2 = makeWedge(props.template)
	w2.Size = Vector3.new(thickness, height, math.abs(ac:Dot(back)))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2 + offset, -right, up, -back)
	for _, w in { w1, w2 } do
		w.Color = props.color
		w.Material = props.material or Enum.Material.SmoothPlastic
		w.Anchored = if props.anchored == nil then true else props.anchored
		w.CanCollide = props.canCollide == true
		w.CanQuery = props.canQuery ~= false
		w.Transparency = props.transparency or 0
		w.Parent = props.parent
	end
	return w1, w2
end

return Triangles
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--!strict
-- Interface built entirely from code: shared widgets plus the message queue (QuestAdditionUI), flight HUD
-- (PlaneHUD / FlyingUIController), airport panel (AirportInspector / CargoInventoryUI), map, crash screen and
-- main menu.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local WorldMap = require(Shared.WorldMap)
local MathUtil = require(Shared.Util.MathUtil)

local UI = {}

UI.Colors = {
	panel = Color3.fromRGB(28, 32, 38),
	panelLight = Color3.fromRGB(242, 242, 242),
	text = Color3.fromRGB(240, 240, 240),
	textDark = Color3.fromRGB(32, 32, 32),
	muted = Color3.fromRGB(150, 156, 165),
	accent = Color3.fromRGB(200, 123, 44), -- the original's selected-button orange
	good = Color3.fromRGB(90, 170, 100),
	bad = Color3.fromRGB(200, 70, 60),
	fuel = Color3.fromRGB(230, 180, 60),
	electric = Color3.fromRGB(90, 170, 230),
}
local C = UI.Colors
UI.Font = Enum.Font.GothamMedium
UI.FontBold = Enum.Font.GothamBold

function UI.new(class: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	for k, v in props or {} do
		(inst :: any)[k] = v
	end
	for _, c in children or {} do
		c.Parent = inst
	end
	return inst
end

function UI.corner(radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UI.padding(p: number): UIPadding
	return UI.new("UIPadding", { PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p), PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p) })
end

function UI.list(dir: Enum.FillDirection?, pad: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, pad or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	})
end

function UI.panel(props: { [string]: any }?): Frame
	local f = UI.new("Frame", { BackgroundColor3 = C.panel, BackgroundTransparency = 0.12, BorderSizePixel = 0 })
	for k, v in props or {} do
		(f :: any)[k] = v
	end
	UI.corner(10).Parent = f
	return f
end

function UI.label(text: string, size: number?, props: { [string]: any }?): TextLabel
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = C.text,
		Font = UI.Font,
		TextSize = size or 16,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, (size or 16) + 6),
		TextWrapped = true,
	})
	for k, v in props or {} do
		(l :: any)[k] = v
	end
	return l
end

function UI.button(text: string, onClick: () -> (), props: { [string]: any }?): TextButton
	local b = UI.new("TextButton", {
		Text = text,
		Font = UI.FontBold,
		TextSize = 16,
		TextColor3 = C.textDark,
		BackgroundColor3 = C.panelLight,
		AutoButtonColor = true,
		Size = UDim2.new(0, 140, 0, 36),
		BorderSizePixel = 0,
		RichText = true,
	})
	for k, v in props or {} do
		(b :: any)[k] = v
	end
	UI.corner(8).Parent = b
	b.Activated:Connect(onClick)
	return b
end

function UI.bar(color: Color3, props: { [string]: any }?): (Frame, Frame)
	local back = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(60, 64, 70), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 10) })
	for k, v in props or {} do
		(back :: any)[k] = v
	end
	UI.corner(5).Parent = back
	local fill = UI.new("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, Size = UDim2.new(0.5, 0, 1, 0), Parent = back })
	UI.corner(5).Parent = fill
	return back, fill
end

-- Unity rich text -> Roblox rich text
function UI.rich(text: string): string
	text = text:gsub("<color=([#%w]+)>", function(c)
		local named = { black = "#202020", white = "#FFFFFF", red = "#D04030", green = "#40A050", orange = "#C87B2C" }
		return '<font color="' .. (named[c] or c) .. '">'
	end)
	text = text:gsub("</color>", "</font>")
	text = text:gsub("<size=[^>]*>", ""):gsub("</size>", "")
	return text
end

function UI.screen(name: string, order: number?): ScreenGui
	local player = Players.LocalPlayer
	local gui = UI.new("ScreenGui", { Name = name, ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = order or 1, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
	gui.Parent = player:WaitForChild("PlayerGui")
	return gui
end

-- ------------------------------------------------------------------------------------------- messages
-- Quest / story messages appear one at a time and wait for "OK" (QuestAdditionUI).
local Messages = {}
Messages.__index = Messages
UI.Messages = Messages

function Messages.new()
	local self = setmetatable({}, Messages)
	self.queue = {}
	self.gui = UI.screen("Messages", 20)
	local box = UI.panel({ Size = UDim2.new(0, 520, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -110), Visible = false, Parent = self.gui })
	UI.padding(16).Parent = box
	UI.list(Enum.FillDirection.Vertical, 10).Parent = box
	self.title = UI.label("", 14, { TextColor3 = C.accent, Font = UI.FontBold, LayoutOrder = 1, Parent = box })
	self.text = UI.label("", 18, { AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2, Parent = box })
	self.ok = UI.button("OK", function()
		self:advance()
	end, { LayoutOrder = 3, Parent = box, BackgroundColor3 = C.accent, TextColor3 = C.text })
	self.box = box
	return self
end

function Messages:push(text: string, kind: string?)
	if text == nil or text == "" then
		return
	end
	table.insert(self.queue, { text = text, kind = kind or "Misc" })
	if not self.box.Visible then
		self:show()
	end
end

function Messages:show()
	local m = self.queue[1]
	if not m then
		self.box.Visible = false
		return
	end
	local titles = { QuestAdded = "NEW JOB", QuestCompleted = "JOB COMPLETE", Mystery = "INCOMING RADIO SIGNAL...", Misc = "MESSAGE", Warning = "WARNING" }
	self.title.Text = titles[m.kind] or "MESSAGE"
	self.title.TextColor3 = if m.kind == "Mystery" then Color3.fromRGB(150, 200, 255) else C.accent
	self.text.Text = UI.rich(m.text)
	self.box.Visible = true
end

function Messages:advance()
	table.remove(self.queue, 1)
	self:show()
end

function Messages:isOpen(): boolean
	return self.box.Visible
end

-- ------------------------------------------------------------------------------------------- toasts (FlightWarningManager)
function UI.toast(gui: ScreenGui, text: string, color: Color3?)
	local t = UI.label(text, 18, {
		Size = UDim2.new(0, 420, 0, 34),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		BackgroundTransparency = 0.2,
		BackgroundColor3 = color or C.panel,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = gui,
	})
	UI.corner(8).Parent = t
	task.delay(3, function()
		TweenService:Create(t, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		task.wait(0.6)
		t:Destroy()
	end)
end

-- ------------------------------------------------------------------------------------------- flight HUD
local HUD = {}
HUD.__index = HUD
UI.HUD = HUD

function HUD.new(callbacks: any)
	local self = setmetatable({}, HUD)
	self.gui = UI.screen("FlightHUD", 5)
	local left = UI.panel({ Size = UDim2.new(0, 230, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0, 16, 1, -16), AnchorPoint = Vector2.new(0, 1), Parent = self.gui })
	UI.padding(12).Parent = left
	UI.list(nil, 6).Parent = left
	self.speed = UI.label("0 km/h", 26, { Font = UI.FontBold, LayoutOrder = 1, Parent = left })
	self.altitude = UI.label("ALT 0 m", 14, { TextColor3 = C.muted, LayoutOrder = 2, Parent = left })
	UI.label("THROTTLE", 12, { TextColor3 = C.muted, LayoutOrder = 3, Parent = left })
	local _, thr = UI.bar(C.accent, { LayoutOrder = 4, Parent = left })
	self.throttle = thr
	self.fuelLabel = UI.label("FUEL", 12, { TextColor3 = C.muted, LayoutOrder = 5, Parent = left })
	local _, fuel = UI.bar(C.fuel, { LayoutOrder = 6, Parent = left })
	self.fuel = fuel
	self.elecLabel = UI.label("BATTERY", 12, { TextColor3 = C.muted, LayoutOrder = 7, Parent = left })
	local eback, elec = UI.bar(C.electric, { LayoutOrder = 8, Parent = left })
	self.elecBack = eback
	self.elec = elec
	self.cargo = UI.label("", 14, { LayoutOrder = 9, Parent = left })
	self.status = UI.label("", 13, { TextColor3 = C.muted, LayoutOrder = 10, Parent = left })

	local top = UI.panel({ Size = UDim2.new(0, 0, 0, 40), AutomaticSize = Enum.AutomaticSize.X, Position = UDim2.new(0, 16, 0, 16), Parent = self.gui })
	UI.padding(10).Parent = top
	UI.list(Enum.FillDirection.Horizontal, 18).Parent = top
	self.money = UI.label("", 18, { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), Font = UI.FontBold, Parent = top })
	self.scrapLabel = UI.label("", 18, { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), Parent = top })

	local obj = UI.panel({ Size = UDim2.new(0, 360, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Parent = self.gui })
	UI.padding(12).Parent = obj
	UI.list(nil, 4).Parent = obj
	UI.label("JOBS", 12, { TextColor3 = C.accent, Font = UI.FontBold, LayoutOrder = 0, Parent = obj })
	self.objectives = UI.label("Land at an airport to get a job.", 15, { AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 1, Parent = obj })
	self.objectivePanel = obj

	self.warning = UI.label("", 18, { Font = UI.FontBold, TextColor3 = Color3.fromRGB(255, 200, 80), Size = UDim2.new(0, 600, 0, 50), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.5, Parent = self.gui })

	local buttons = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 40), AutomaticSize = Enum.AutomaticSize.X, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Parent = self.gui })
	UI.list(Enum.FillDirection.Horizontal, 8).Parent = buttons
	self.airportButton = UI.button("Airport (Enter)", callbacks.openAirport, { Size = UDim2.new(0, 160, 0, 40), BackgroundColor3 = C.accent, TextColor3 = C.text, Visible = false, Parent = buttons })
	UI.button("Map (M)", callbacks.openMap, { Size = UDim2.new(0, 110, 0, 40), Parent = buttons })
	UI.button("Controls", callbacks.showControls, { Size = UDim2.new(0, 110, 0, 40), Parent = buttons })
	return self
end

function HUD:update(t: any, campaign: any?, objectives: string?, nearAirport: any?)
	self.speed.Text = string.format("%d km/h", math.floor(t.speed * 3.6 + 0.5))
	self.altitude.Text = string.format("ALT %d m   GROUND %s m", math.floor(t.altitude + 0.5), if t.height > 4000 then "--" else tostring(math.floor(t.height + 0.5)))
	self.throttle.Size = UDim2.new(math.clamp(math.abs(t.throttle), 0, 1), 0, 1, 0)
	self.throttle.BackgroundColor3 = if t.throttle < 0 then C.bad else C.accent
	self.fuel.Size = UDim2.new(math.clamp(t.fuel / math.max(t.fuelCapacity, 1e-3), 0, 1), 0, 1, 0)
	self.fuelLabel.Text = string.format("FUEL  %d / %d", math.floor(t.fuel + 0.5), math.floor(t.fuelCapacity + 0.5))
	self.elecBack.Visible = t.hasElectric
	self.elecLabel.Visible = t.hasElectric
	self.elec.Size = UDim2.new(math.clamp(t.electricity / math.max(t.batteryCapacity, 1e-3), 0, 1), 0, 1, 0)
	if campaign then
		local parts = {}
		for id, n in campaign.cargo do
			table.insert(parts, n .. " " .. (WorldMap.CargoTypes[id] and WorldMap.CargoTypes[id].name or id))
		end
		self.cargo.Text = string.format("CARGO %d / %d  %s", campaign.cargoVolume, math.floor(t.cargoVolume + 0.5), table.concat(parts, ", "))
		self.money.Text = "💰 " .. MathUtil.formatNumber(campaign.money)
		self.scrapLabel.Text = "⚙ " .. campaign.scrap .. (if campaign.advancedScrap > 0 then "   ✦ " .. campaign.advancedScrap else "")
	end
	local status = {}
	if t.retracted then
		table.insert(status, "Gear up")
	end
	if t.braking then
		table.insert(status, "Air brakes")
	end
	self.status.Text = table.concat(status, " · ")
	local warn = nil
	for title, hint in t.warnings do
		warn = title .. " — " .. hint
	end
	if t.fuel <= 0 and t.fuelCapacity > 0 then
		warn = "Out of fuel"
	end
	self.warning.Text = warn or ""
	if objectives then
		self.objectives.Text = UI.rich(objectives)
	end
	self.airportButton.Visible = nearAirport ~= nil
	if nearAirport then
		self.airportButton.Text = nearAirport.name .. " (Enter)"
	end
end

function HUD:destroy()
	self.gui:Destroy()
end

-- ------------------------------------------------------------------------------------------- airport panel
local AirportPanel = {}
AirportPanel.__index = AirportPanel
UI.AirportPanel = AirportPanel

function AirportPanel.new(callbacks: any)
	local self = setmetatable({}, AirportPanel)
	self.callbacks = callbacks
	self.gui = UI.screen("AirportPanel", 10)
	local frame = UI.panel({ Size = UDim2.new(0, 460, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Visible = false, Parent = self.gui })
	UI.padding(16).Parent = frame
	UI.list(nil, 10).Parent = frame
	self.frame = frame
	self.title = UI.label("", 24, { Font = UI.FontBold, LayoutOrder = 1, Parent = frame })
	self.quest = UI.label("", 16, { AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2, Parent = frame })
	UI.label("CARGO FOR PICKUP", 12, { TextColor3 = C.accent, Font = UI.FontBold, LayoutOrder = 3, Parent = frame })
	self.cargoList = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = frame })
	UI.list(nil, 6).Parent = self.cargoList
	self.space = UI.label("", 14, { TextColor3 = C.muted, LayoutOrder = 5, Parent = frame })
	local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 6, Parent = frame })
	UI.list(Enum.FillDirection.Horizontal, 8).Parent = row
	self.refuel = UI.button("Refuel", function()
		callbacks.refuel()
		self:refresh()
	end, { Parent = row })
	self.hangar = UI.button("Hangar", callbacks.hangar, { Parent = row })
	UI.button("Take off", function()
		self:close()
	end, { Parent = row, BackgroundColor3 = C.accent, TextColor3 = C.text })
	return self
end

function AirportPanel:open(airport: any, campaign: any, flight: any)
	self.airport, self.campaign, self.flight = airport, campaign, flight
	self.frame.Visible = true
	self:refresh()
end

function AirportPanel:refresh()
	local airport, campaign, flight = self.airport, self.campaign, self.flight
	if not airport then
		return
	end
	self.title.Text = airport.name
	local state = campaign.airports[airport.id]
	local q = state.currentQuest
	if q and state.questInitialized and not q.completed then
		local stage = campaign:questStage(q, flight.cargoVolume)
		self.quest.Text = UI.rich("<b>" .. q.name .. "</b>\n" .. q.description .. (if stage then "\n<i>" .. stage .. "</i>" else ""))
	elseif state.questBlocked then
		self.quest.Text = "No work available here yet."
	else
		self.quest.Text = "No jobs right now."
	end
	for _, c in self.cargoList:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local locked = not campaign:airportCargoUnlocked(airport.id)
	for _, id in airport.cargoTypes do
		local cargo = WorldMap.CargoTypes[id]
		local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Parent = self.cargoList })
		local info = string.format("<b>%s</b>  · %d space · %.1f t%s%s", cargo.name, cargo.cargoSpace, cargo.weight, if cargo.fragile then " · fragile" else "", if cargo.expires then " · perishable" else "")
		UI.label(info, 15, { Size = UDim2.new(1, -170, 1, 0), Parent = row })
		UI.label("x" .. campaign:cargoCount(id), 16, { Size = UDim2.new(0, 40, 1, 0), Position = UDim2.new(1, -165, 0, 0), Parent = row })
		UI.button("−", function()
			campaign:removeCargo(id, 1)
			self.callbacks.cargoChanged()
			self:refresh()
		end, { Size = UDim2.new(0, 50, 0, 30), Position = UDim2.new(1, -115, 0, 2), Parent = row })
		local add = UI.button("+", function()
			if not campaign:addCargo(id, flight.cargoVolume, airport.id) then
				UI.toast(self.gui, if locked then "This cargo is not available yet" else "Not enough cargo space", C.bad)
			end
			self.callbacks.cargoChanged()
			self:refresh()
		end, { Size = UDim2.new(0, 50, 0, 30), Position = UDim2.new(1, -55, 0, 2), Parent = row })
		add.AutoButtonColor = not locked
	end
	if #airport.cargoTypes == 0 then
		UI.label("Nothing to pick up here.", 14, { TextColor3 = C.muted, Parent = self.cargoList })
	elseif locked then
		UI.label("Cargo here is locked for now.", 14, { TextColor3 = C.bad, Parent = self.cargoList })
	end
	self.space.Text = string.format("Cargo space used: %d / %d", campaign.cargoVolume, math.floor(flight.cargoVolume + 0.5))
	local canRefuel = airport.data.refuel or airport.isBase
	self.refuel.Visible = canRefuel
	self.refuel.Text = if canRefuel then "Refuel" else "No fuel here"
	self.hangar.Visible = airport.isBase
end

function AirportPanel:close()
	self.frame.Visible = false
	self.airport = nil
end

function AirportPanel:isOpen(): boolean
	return self.frame.Visible
end

-- ------------------------------------------------------------------------------------------- map
local MapView = {}
MapView.__index = MapView
UI.MapView = MapView

function MapView.new()
	local self = setmetatable({}, MapView)
	self.gui = UI.screen("Map", 12)
	local frame = UI.panel({ Size = UDim2.new(0.8, 0, 0.85, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Visible = false, BackgroundColor3 = Color3.fromRGB(70, 104, 150), BackgroundTransparency = 0, ClipsDescendants = true, Parent = self.gui })
	self.frame = frame
	UI.label("MAP — press M to close", 14, { Position = UDim2.new(0, 12, 0, 8), Size = UDim2.new(1, -24, 0, 20), Parent = frame })
	self.canvas = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -40, 1, -50), Position = UDim2.new(0, 20, 0, 36), Parent = frame })
	-- world bounds (Unity space)
	self.minX, self.maxX, self.minZ, self.maxZ = -20000, 11000, -3000, 28000
	return self
end

function MapView:toCanvas(ux: number, uz: number): UDim2
	-- North (+Z) up. Unity +X is to the right on the map, matching the original game's map.
	local fx = (ux - self.minX) / (self.maxX - self.minX)
	local fz = 1 - (uz - self.minZ) / (self.maxZ - self.minZ)
	return UDim2.new(fx, 0, fz, 0)
end

function MapView:toggle(campaign: any?, planePosition: Vector3, heading: Vector3, targets: { any })
	self.frame.Visible = not self.frame.Visible
	if self.frame.Visible then
		self:draw(campaign, planePosition, heading, targets)
	end
end

function MapView:draw(campaign: any?, planePosition: Vector3, heading: Vector3, targets: { any })
	self.canvas:ClearAllChildren()
	for _, c in WorldMap.Continents do
		local discovered = campaign == nil
		for _, a in c.airports do
			if campaign and campaign:isDiscovered(a.position.X, a.position.Z) then
				discovered = true
			end
		end
		if discovered then
			local size = c.radius * 2 / (self.maxX - self.minX)
			local blob = UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = self:toCanvas(c.origin.X, c.origin.Z),
				Size = UDim2.new(size, 0, size * (self.maxX - self.minX) / (self.maxZ - self.minZ), 0),
				BackgroundColor3 = Color3.new(table.unpack(c.type.surfaceColor or { 0.5, 0.6, 0.4 })),
				BackgroundTransparency = 0.15,
				BorderSizePixel = 0,
				Parent = self.canvas,
			})
			UI.corner(9999).Parent = blob
		end
	end
	for _, a in WorldMap.Airports do
		if campaign == nil or campaign:isDiscovered(a.position.X, a.position.Z) then
			local dot = UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = self:toCanvas(a.position.X, a.position.Z), Size = UDim2.new(0, 10, 0, 10), BackgroundColor3 = if a.isBase then C.accent else Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = self.canvas })
			UI.corner(5).Parent = dot
			UI.label(a.name, 12, { Position = UDim2.new(0, 8, 0, -6), Size = UDim2.new(0, 200, 0, 16), TextStrokeTransparency = 0.6, Parent = dot })
		end
	end
	for _, t in targets do
		local m = UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = self:toCanvas(t.position.X, t.position.Z), Size = UDim2.new(0, 22, 0, 22), BackgroundTransparency = 1, Parent = self.canvas })
		UI.new("UIStroke", { Color = Color3.fromRGB(255, 220, 80), Thickness = 3, Parent = m })
		UI.corner(11).Parent = m
	end
	if campaign then
		for _, s in campaign.scrapSpots do
			if campaign:isDiscovered(s.x, s.z) then
				local d = UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = self:toCanvas(s.x, s.z), Size = UDim2.new(0, 6, 0, 6), BackgroundColor3 = Color3.fromRGB(255, 170, 60), BorderSizePixel = 0, Parent = self.canvas })
				UI.corner(3).Parent = d
			end
		end
	end
	local ux, uz = -planePosition.X, planePosition.Z
	local arrow = UI.label("▲", 22, { AnchorPoint = Vector2.new(0.5, 0.5), Position = self:toCanvas(ux, uz), Size = UDim2.new(0, 24, 0, 24), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(255, 80, 60), Parent = self.canvas })
	arrow.Rotation = math.deg(math.atan2(-heading.X, heading.Z))
end

function MapView:isOpen(): boolean
	return self.frame.Visible
end

-- ------------------------------------------------------------------------------------------- crash / game over
function UI.gameOver(text: string, options: { { string | () -> () } }): ScreenGui
	local gui = UI.screen("GameOver", 30)
	local back = UI.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Size = UDim2.new(1, 0, 1, 0), Parent = gui })
	local box = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 500, 0, 200), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Parent = back })
	UI.list(nil, 16, Enum.HorizontalAlignment.Center).Parent = box
	UI.label(text, 42, { Font = UI.FontBold, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 50), Parent = box })
	local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = box })
	UI.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = row
	for _, o in options do
		UI.button(o[1] :: string, function()
			gui:Destroy();
			(o[2] :: () -> ())()
		end, { Size = UDim2.new(0, 200, 0, 44), Parent = row })
	end
	return gui
end

-- ------------------------------------------------------------------------------------------- simple modal with text
function UI.modal(title: string, body: string): ScreenGui
	local gui = UI.screen("Modal", 40)
	local frame = UI.panel({ Size = UDim2.new(0, 520, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Parent = gui })
	UI.padding(18).Parent = frame
	UI.list(nil, 10).Parent = frame
	UI.label(title, 22, { Font = UI.FontBold, LayoutOrder = 1, Parent = frame })
	UI.label(body, 16, { AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2, Parent = frame })
	UI.button("Close", function()
		gui:Destroy()
	end, { LayoutOrder = 3, Parent = frame })
	return gui
end

UI.ControlsText = table.concat({
	"<b>Flying</b>",
	"W / S — pitch down / up      A / D — roll      Q / E — yaw (rudder)",
	"Space — throttle up (hold near the ground to help take-off)      Ctrl or Shift — throttle down / brake / reverse",
	"G — retract landing gear      F — decouple      M — map      Enter — airport menu when landed",
	"Right mouse drag — look around      Mouse wheel — zoom      C — cockpit camera",
	"",
	"<b>Building</b>",
	"Click a part, then click on the plane to attach it      R / T — rotate      X — mirror mode",
	"Click a placed part to select it      Delete — remove it      Ctrl+Z — undo",
	"Right mouse drag — orbit      Mouse wheel — zoom",
}, "\n")

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">WorldStreamer</string>
              <string name="Source"><![CDATA[--!strict
-- Streams the world around the camera: low-poly terrain chunks (TerrainGenerationManager / Chunk), the sea,
-- airport models (Chunk.SpawnAirport) and scrap piles (ScrapSpawner).
-- Terrain triangles are drawn with wedges; near chunks are detailed and collidable, far chunks are coarse.
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local WorldMap = require(Shared.WorldMap)
local Noise = require(Shared.Util.Noise)
local Triangles = require(script.Parent.Triangles)
local PartVisual = require(script.Parent.PartVisual)

local WorldStreamer = {}
WorldStreamer.__index = WorldStreamer

local CHUNK = WorldMap.ChunkSize
local NEAR_RES = 20 -- cells per chunk side near the plane (50 m cells, colliding)
local FAR_RES = 8 -- cells per chunk side further out
local NEAR_RADIUS = 1
local FAR_RADIUS = 3
local AIRPORT_LOAD = 3500
local AIRPORT_UNLOAD = 4500
local BUDGET = 0.006 -- seconds of generation work per frame

local function c3(t: { number }?, fallback: Color3): Color3
	if not t then
		return fallback
	end
	return Color3.new(t[1], t[2], t[3])
end

function WorldStreamer.new(campaign: any?)
	local self = setmetatable({}, WorldStreamer)
	self.campaign = campaign
	self.folder = Instance.new("Folder")
	self.folder.Name = "World"
	self.folder.Parent = Workspace
	self.chunks = {} :: { [string]: any }
	self.airports = {} :: { [number]: any }
	self.scrap = {} :: { [any]: Instance }
	self.queue = {} :: { any }
	self.focus = Vector3.zero

	local sea = Instance.new("Part")
	sea.Name = "Sea"
	sea.Anchored = true
	sea.CanCollide = false
	sea.CanQuery = false
	sea.CanTouch = false
	sea.Size = Vector3.new(2048, 1, 2048)
	sea.Material = Enum.Material.Glass
	sea.Color = Color3.new(0.33, 0.44, 0.55)
	sea.Transparency = 0.15
	sea.Parent = self.folder
	self.sea = sea
	local farSea = sea:Clone()
	farSea.Name = "FarSea"
	farSea.Size = Vector3.new(2048, 0.5, 2048)
	self.farSeas = {}
	for i = 1, 8 do
		local s = farSea:Clone()
		s.Parent = self.folder
		table.insert(self.farSeas, s)
	end

	self.connection = RunService.Heartbeat:Connect(function()
		self:update()
	end)
	return self
end

-- Colour of a terrain triangle (the original terrain shader blended grass/sand/dirt/rock by height and slope).
local function triangleColor(continentColors: any, ux: number, uz: number, height: number, slope: number): Color3
	local grass = c3(continentColors and continentColors.grass, Color3.new(0.567, 0.567, 0.39))
	local sand = c3(continentColors and continentColors.sand, Color3.new(0.78, 0.66, 0.5))
	local dirt = c3(continentColors and continentColors.dirt, Color3.new(0.6, 0.5, 0.36))
	local rock = c3(continentColors and continentColors.rock, Color3.new(0.7, 0.68, 0.66))
	local strength = (continentColors and continentColors.noise) or 0.05
	local jitter = (Noise.perlin(ux * 0.0025, uz * 0.0025) - 0.5) * strength
	local col = grass
	if slope > 0.12 - jitter then
		col = dirt
	end
	if slope > 0.3 - jitter then
		col = rock
	end
	if height < 2.5 + jitter * 40 then
		col = sand
	end
	local k = 1 + jitter * 2
	return Color3.new(math.clamp(col.R * k, 0, 1), math.clamp(col.G * k, 0, 1), math.clamp(col.B * k, 0, 1))
end

local function chunkKey(cx: number, cz: number): string
	return cx .. "," .. cz
end

-- Builds one chunk (yields between rows so it never blocks a frame for long).
function WorldStreamer:buildChunk(cx: number, cz: number, res: number, collide: boolean)
	local key = chunkKey(cx, cz)
	local model = Instance.new("Model")
	model.Name = "Chunk_" .. key .. "_" .. res
	local step = CHUNK / res
	local x0 = cx * CHUNK - CHUNK / 2
	local z0 = cz * CHUNK - CHUNK / 2
	local heights = {}
	local start = os.clock()
	local function maybeYield()
		if os.clock() - start > BUDGET then
			task.wait()
			start = os.clock()
		end
	end
	for i = 0, res do
		heights[i] = {}
		for j = 0, res do
			heights[i][j] = WorldMap.height(x0 + i * step, z0 + j * step)
		end
		maybeYield()
	end
	local colors = WorldMap.terrainColors(cx * CHUNK, cz * CHUNK)
	local anyAboveSea = false
	for i = 0, res - 1 do
		for j = 0, res - 1 do
			local h00, h10, h01, h11 = heights[i][j], heights[i + 1][j], heights[i][j + 1], heights[i + 1][j + 1]
			if math.max(h00, h10, h01, h11) > WorldMap.SeaLevel - 30 then
				anyAboveSea = anyAboveSea or math.max(h00, h10, h01, h11) > WorldMap.SeaLevel
				local ux, uz = x0 + i * step, z0 + j * step
				-- Unity -> Roblox: mirror X
				local p00 = Vector3.new(-ux, h00, uz)
				local p10 = Vector3.new(-(ux + step), h10, uz)
				local p01 = Vector3.new(-ux, h01, uz + step)
				local p11 = Vector3.new(-(ux + step), h11, uz + step)
				for _, tri in { { p00, p11, p10 }, { p00, p01, p11 } } do
					local a, b, c = tri[1], tri[2], tri[3]
					local n = (b - a):Cross(c - a)
					if n.Y < 0 then
						n = -n
					end
					local slope = 1 - math.clamp(n.Unit.Y, 0, 1)
					local h = (a.Y + b.Y + c.Y) / 3
					local col = triangleColor(colors, ux + step / 2, uz + step / 2, h, slope)
					Triangles.draw(a, b, c, { color = col, thickness = 2, outward = Vector3.yAxis, parent = model, canCollide = collide, canQuery = collide, material = Enum.Material.SmoothPlastic })
				end
			end
		end
		maybeYield()
	end
	model:SetAttribute("Res", res)
	return model
end

function WorldStreamer:wantedChunks(focus: Vector3)
	-- focus is in Roblox space; chunks are indexed in Unity space
	local ux, uz = -focus.X, focus.Z
	local cx, cz = math.floor(ux / CHUNK + 0.5), math.floor(uz / CHUNK + 0.5)
	local wanted = {}
	for i = -FAR_RADIUS, FAR_RADIUS do
		for j = -FAR_RADIUS, FAR_RADIUS do
			local near = math.abs(i) <= NEAR_RADIUS and math.abs(j) <= NEAR_RADIUS
			wanted[chunkKey(cx + i, cz + j)] = { cx = cx + i, cz = cz + j, res = if near then NEAR_RES else FAR_RES, collide = near, dist = math.max(math.abs(i), math.abs(j)) }
		end
	end
	return wanted
end

function WorldStreamer:setFocus(position: Vector3)
	self.focus = position
end

-- Synchronously make sure the ground under a position exists (used before spawning a plane).
function WorldStreamer:ensureNear(position: Vector3)
	self.focus = position
	local wanted = self:wantedChunks(position)
	for key, w in wanted do
		if w.collide then
			local existing = self.chunks[key]
			if not existing or existing.res ~= w.res then
				local model = self:buildChunk(w.cx, w.cz, w.res, w.collide)
				model.Parent = self.folder
				if existing and existing.model then
					existing.model:Destroy()
				end
				self.chunks[key] = { model = model, res = w.res }
			end
		end
	end
	self:updateAirports(true)
end

function WorldStreamer:update()
	local focus = self.focus
	self.sea.Position = Vector3.new(math.floor(focus.X / 100) * 100, WorldMap.SeaLevel - 0.5, math.floor(focus.Z / 100) * 100)
	local k = 1
	for i = -1, 1 do
		for j = -1, 1 do
			if i ~= 0 or j ~= 0 then
				local s = self.farSeas[k]
				s.Position = self.sea.Position + Vector3.new(i * 2048, -0.3, j * 2048)
				k += 1
			end
		end
	end

	if not self.working then
		local wanted = self:wantedChunks(focus)
		-- unload chunks we no longer need
		for key, c in self.chunks do
			if not wanted[key] then
				if c.model then
					c.model:Destroy()
				end
				self.chunks[key] = nil
			end
		end
		-- pick the closest missing / wrong-resolution chunk
		local best = nil
		for key, w in wanted do
			local c = self.chunks[key]
			if not c or c.res ~= w.res then
				if not best or w.dist < best.dist then
					best = w
					best.key = key
				end
			end
		end
		if best then
			self.working = true
			task.spawn(function()
				local ok, model = pcall(function()
					return self:buildChunk(best.cx, best.cz, best.res, best.collide)
				end)
				if ok and model then
					local old = self.chunks[best.key]
					model.Parent = self.folder
					if old and old.model then
						old.model:Destroy()
					end
					self.chunks[best.key] = { model = model, res = best.res }
				else
					warn("[Aviassembly] terrain chunk failed:", model)
				end
				self.working = false
			end)
		end
	end
	self:updateAirports(false)
	self:updateScrap()
end

function WorldStreamer:spawnAirport(airport: any)
	local model = Instance.new("Model")
	model.Name = "Airport_" .. airport.name
	local cf = WorldMap.airportCFrame(airport)
	local meshes = airport.data.meshes or {}
	local imported = PartVisual.hasImportedMeshes()
	if imported then
		for _, node in meshes do
			local piece = PartVisual.meshPiece(node, cf * CFrame.new(node.center[1], node.center[2], node.center[3]), model)
			piece.CanCollide = true
			piece.CanQuery = true
		end
	end
	-- Runway pad: always present so landing works even before the models are imported.
	local pad = Instance.new("Part")
	pad.Name = "Runway"
	pad.Anchored = true
	local fp = airport.flatness.size
	pad.Size = Vector3.new(fp.X * 2, 0.4, fp.Y * 2)
	pad.CFrame = cf * CFrame.new(0, -0.15, 0)
	pad.Color = Color3.fromRGB(90, 92, 96)
	pad.Material = Enum.Material.Asphalt
	pad.Transparency = if imported then 1 else 0
	pad.CanCollide = true
	pad.Parent = model
	if airport.data.offshore then
		-- ships: put the deck at sea level when there is no model
		pad.CFrame = cf * CFrame.new(0, WorldMap.SeaLevel + 8, 0)
	end
	model.Parent = self.folder
	return model
end

function WorldStreamer:updateAirports(force: boolean)
	local focus = self.focus
	for _, airport in WorldMap.Airports do
		local p = airport.position
		local dx, dz = -p.X - focus.X, p.Z - focus.Z
		local d = math.sqrt(dx * dx + dz * dz)
		local loaded = self.airports[airport.index]
		if d < AIRPORT_LOAD and not loaded then
			self.airports[airport.index] = self:spawnAirport(airport)
		elseif d > AIRPORT_UNLOAD and loaded then
			loaded:Destroy()
			self.airports[airport.index] = nil
		end
	end
end

function WorldStreamer:updateScrap()
	local campaign = self.campaign
	if not campaign then
		return
	end
	local alive = {}
	for _, s in campaign.scrapSpots do
		alive[s] = true
		if not self.scrap[s] then
			local h = WorldMap.height(s.x, s.z)
			local beacon = Instance.new("Part")
			beacon.Name = "Scrap"
			beacon.Anchored = true
			beacon.CanCollide = false
			beacon.CanQuery = false
			beacon.Material = Enum.Material.Neon
			beacon.Color = Color3.fromRGB(255, 170, 60)
			beacon.Shape = Enum.PartType.Cylinder
			beacon.Size = Vector3.new(400, 3, 3)
			beacon.Transparency = 0.4
			beacon.CFrame = CFrame.new(-s.x, math.max(h, WorldMap.SeaLevel) + 200, s.z) * CFrame.Angles(0, 0, math.pi / 2)
			local pile = Instance.new("Part")
			pile.Name = "ScrapPile"
			pile.Anchored = true
			pile.CanCollide = false
			pile.Size = Vector3.new(8, 4, 8)
			pile.Color = Color3.fromRGB(120, 110, 100)
			pile.Material = Enum.Material.CorrodedMetal
			pile.CFrame = CFrame.new(-s.x, math.max(h, WorldMap.SeaLevel) + 2, s.z)
			pile.Parent = beacon
			beacon.Parent = self.folder
			self.scrap[s] = beacon
		end
	end
	for s, inst in self.scrap do
		if not alive[s] then
			inst:Destroy()
			self.scrap[s] = nil
		end
	end
end

function WorldStreamer:destroy()
	if self.connection then
		self.connection:Disconnect()
	end
	self.folder:Destroy()
end

return WorldStreamer
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="30">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Aviassembly for Roblox: game flow (GameManager), flight loop, camera (CameraController), saving (AutoSave).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WorldMap = require(Shared.WorldMap)
local Campaign = require(Shared.Campaign)
local Parts = require(Shared.Data.Parts)
local Game = script.Parent:WaitForChild("Game")
local UI = require(Game.UI)
local Frames = require(Game.Frames)
local PlaneDesign = require(Game.PlaneDesign)
local PartVisual = require(Game.PartVisual)
local Hangar = require(Game.Hangar)
local Flight = require(Game.Flight)
local WorldStreamer = require(Game.WorldStreamer)

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local C = UI.Colors

-- ------------------------------------------------------------------------------------------- world settings
Workspace.Gravity = Flight.Gravity
Lighting.FogStart = 300
Lighting.FogEnd = 3500
Lighting.FogColor = Color3.new(0.448, 0.561, 0.638) -- DefaultFog profile
Lighting.ClockTime = 13
Lighting.Brightness = 2
Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
Lighting.GlobalShadows = true
local sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
sky.CelestialBodiesShown = true
sky.Parent = Lighting
local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
atmosphere.Density = 0.25
atmosphere.Color = Color3.new(0.448, 0.561, 0.638)
atmosphere.Decay = Color3.new(0.01, 0.2, 0.333)
atmosphere.Haze = 1
atmosphere.Parent = Lighting
camera.CameraType = Enum.CameraType.Scriptable
camera.FieldOfView = 70

-- ------------------------------------------------------------------------------------------- state
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
local campaign = nil
local design = PlaneDesign.new()
local savedDesigns = {}
local messages = UI.Messages.new()
local streamer = nil
local hangar = nil
local flight = nil
local hud, airportPanel, mapView = nil, nil, nil
local flightConnections = {}
local mode = "menu"
local saveData = nil

local function hookCampaign()
	campaign.onMessage = function(text, kind)
		messages:push(text, kind)
	end
	campaign.onReward = function(info)
		if hud and (info.money ~= 0 or info.scrap ~= 0 or info.advancedScrap ~= 0) then
			local parts = {}
			if info.money ~= 0 then
				table.insert(parts, "💰 +" .. math.floor(info.money + 0.5))
			end
			if info.scrap ~= 0 then
				table.insert(parts, "⚙ +" .. info.scrap)
			end
			if info.advancedScrap ~= 0 then
				table.insert(parts, "✦ +" .. info.advancedScrap)
			end
			UI.toast(hud.gui, table.concat(parts, "   "), C.good)
		end
	end
end

local function save()
	if not campaign or not Remotes then
		return
	end
	local data = { campaign = campaign:serialize(), design = design:serialize(), designs = savedDesigns }
	task.spawn(function()
		local ok, result = pcall(function()
			return Remotes.SaveGame:InvokeServer(data)
		end)
		if not ok then
			warn("[Aviassembly] save failed:", result)
		end
	end)
end

local function load()
	if not Remotes then
		return nil
	end
	local ok, data = pcall(function()
		return Remotes.LoadGame:InvokeServer()
	end)
	if ok and type(data) == "table" and data.campaign then
		return data
	end
	return nil
end

-- ------------------------------------------------------------------------------------------- helpers
local function airportById(id)
	return id and WorldMap.airportById(id) or nil
end

local function homeBase()
	return WorldMap.Airports[1]
end

local function robloxPos(a)
	return Vector3.new(-a.position.X, 0, a.position.Z)
end

-- Plane forward in design space (cockpit forward or average engine thrust, like UpdateForwardDirection).
local function designForward(d)
	local forward = Vector3.zAxis
	local engines = Vector3.zero
	local n = 0
	for _, e in d.parts do
		if string.find(e.name, "Cock") then
			forward = e.cf.ZVector
		end
		for _, c in Parts[e.name].components do
			if c.type == "Engine" then
				local dir = if c.data.helicopterRotor == 1 then Frames.v(c.frame.up) else Frames.v(c.frame.right)
				engines += e.cf:VectorToWorldSpace(dir)
				n += 1
			end
		end
	end
	if n > 0 then
		local avg = engines / n
		if avg.Magnitude > 1e-3 and math.abs(avg.Unit.Y) <= 0.5 then
			forward = avg.Unit
		end
	end
	return forward
end

local function designLowest(d)
	local lowest = 0
	for _, e in d.parts do
		local data = Parts[e.name]
		for _, node in data.nodes do
			local c = e.cf * Frames.localPoint(Frames.v(node.center), e.flip)
			local h = node.size[2] / 2
			lowest = math.min(lowest, c.Y - h)
		end
		for _, w in data.components do
			if w.type == "Wheel" then
				local p = e.cf * Frames.localPoint(Frames.v(w.frame.pos), e.flip)
				lowest = math.min(lowest, p.Y - w.data.suspentionLength * 0.6)
			end
		end
		if data.procedural and e.fuselage then
			lowest = math.min(lowest, e.cf.Y - math.max(e.fuselage.side1.radius.Y, e.fuselage.side2.radius.Y))
		end
	end
	return lowest
end

-- GameManager.GetPlaneSpawnPoint / GetPlaneSpawnRotation
local function spawnCFrame(airport)
	local cf = WorldMap.airportCFrame(airport)
	local sp = airport.data.spawn
	local localPos = if sp then Vector3.new(sp.pos[1], sp.pos[2], sp.pos[3]) else Vector3.new(0, 0, -215)
	local localFwd = if sp then Vector3.new(sp.forward[1], sp.forward[2], sp.forward[3]) else Vector3.zAxis
	local pos = cf * localPos
	local fwd = cf:VectorToWorldSpace(localFwd)
	local ground = WorldMap.heightAt(pos)
	if airport.data.offshore then
		ground = pos.Y - 8 + 8
	end
	-- terrain might be below a runway deck; trust whichever is higher
	local rayHit = Workspace:Raycast(pos + Vector3.new(0, 200, 0), Vector3.new(0, -400, 0))
	if rayHit then
		ground = math.max(ground, rayHit.Position.Y)
	end
	-- rotate the design so its flight direction faces the runway direction
	local df = designForward(design)
	local yawDesign = math.atan2(df.X, df.Z)
	local yawSpawn = math.atan2(fwd.X, fwd.Z)
	local rot = CFrame.Angles(0, yawSpawn - yawDesign, 0)
	return CFrame.new(pos.X, ground - designLowest(design) + 0.3, pos.Z) * rot
end

-- ------------------------------------------------------------------------------------------- camera (CameraController)
local cam = { yaw = 0, pitch = 0.25, distance = nil, dragging = false, cockpit = false, smoothedForward = nil, shake = 0 }

local function updateFlightCamera(dt)
	if not flight or not flight.root.Parent then
		return
	end
	local root = flight.root
	local cf = root.CFrame
	local fwd = cf:VectorToWorldSpace(flight.localForward)
	local length = math.max(flight.planeLength, 2)
	cam.distance = cam.distance or (length * 3 + 6)
	if cam.cockpit then
		camera.CFrame = CFrame.lookAt(cf * (flight.boundsCenter + Vector3.new(0, flight.boundsHalf.Y * 0.8, 0)), cf * (flight.boundsCenter + Vector3.new(0, flight.boundsHalf.Y * 0.8, 0)) + fwd, cf.UpVector)
		return
	end
	local vel = root.AssemblyLinearVelocity
	local target = if vel.Magnitude > 8 then vel.Unit:Lerp(fwd, 0.5) else fwd
	cam.smoothedForward = if cam.smoothedForward then cam.smoothedForward:Lerp(target, math.clamp(dt * 3, 0, 1)) else target
	local flat = Vector3.new(cam.smoothedForward.X, 0, cam.smoothedForward.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.zAxis
	end
	local baseYaw = math.atan2(-flat.X, -flat.Z)
	local rot = CFrame.Angles(0, baseYaw + cam.yaw, 0) * CFrame.Angles(-cam.pitch, 0, 0)
	local focus = root.Position
	local pos = focus + rot * Vector3.new(0, 0, cam.distance)
	if cam.shake > 0 then
		pos += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * cam.shake * 2
	end
	camera.CFrame = CFrame.lookAt(pos, focus + Vector3.new(0, length * 0.2, 0))
	local speed = vel.Magnitude
	camera.FieldOfView = 65 + math.clamp(speed / 500, 0, 1) * 25
end

-- ------------------------------------------------------------------------------------------- input
local function readInput()
	local function key(k)
		return UserInputService:IsKeyDown(k)
	end
	local function axis(neg, pos)
		return (if key(pos) then 1 else 0) - (if key(neg) then 1 else 0)
	end
	local throttleUp = key(Enum.KeyCode.Space)
	local throttleDown = key(Enum.KeyCode.LeftControl) or key(Enum.KeyCode.RightControl) or key(Enum.KeyCode.LeftShift)
	return {
		pitch = axis(Enum.KeyCode.S, Enum.KeyCode.W),
		roll = axis(Enum.KeyCode.A, Enum.KeyCode.D),
		yaw = axis(Enum.KeyCode.Q, Enum.KeyCode.E),
		throttle = (if throttleUp then 1 else 0) - (if throttleDown then 1 else 0),
		space = throttleUp,
		retractPressed = false,
		decouplePressed = false,
		autoSteer = true,
	}
end

-- ------------------------------------------------------------------------------------------- modes
local enterHangar, startFlight, showMenu

local function clearFlight()
	for _, c in flightConnections do
		c:Disconnect()
	end
	flightConnections = {}
	if flight then
		flight:destroy()
		flight = nil
	end
	if hud then
		hud:destroy()
		hud = nil
	end
	if airportPanel then
		airportPanel.gui:Destroy()
		airportPanel = nil
	end
	if mapView then
		mapView.gui:Destroy()
		mapView = nil
	end
	cam.shake = 0
end

local function designsMenu()
	local gui = UI.screen("Designs", 25)
	local frame = UI.panel({ Size = UDim2.new(0, 460, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Parent = gui })
	UI.padding(16).Parent = frame
	UI.list(nil, 8).Parent = frame
	UI.label("PLANE DESIGNS", 20, { Font = UI.FontBold, Parent = frame })
	UI.label("Saving keeps a copy of the current plane. Loading replaces the plane in the hangar; the price difference is charged or refunded.", 14, { TextColor3 = C.muted, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = frame })
	for slot = 1, 5 do
		local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), Parent = frame })
		local d = savedDesigns[tostring(slot)]
		UI.label(string.format("Slot %d: %s", slot, if d then (#(d.parts or {}) .. " parts") else "empty"), 16, { Size = UDim2.new(1, -220, 1, 0), Parent = row })
		UI.button("Save", function()
			savedDesigns[tostring(slot)] = design:serialize()
			save()
			gui:Destroy()
			designsMenu()
		end, { Size = UDim2.new(0, 100, 0, 32), Position = UDim2.new(1, -210, 0, 2), Parent = row })
		UI.button("Load", function()
			if not d then
				return
			end
			local newDesign = PlaneDesign.deserialize(d)
			local diff = newDesign:cost() - design:cost()
			if diff > 0 and not campaign:hasMoney(diff) then
				UI.toast(gui, "Not enough money for this design", C.bad)
				return
			end
			campaign:changeMoney(-diff)
			design = newDesign
			gui:Destroy()
			enterHangar()
		end, { Size = UDim2.new(0, 100, 0, 32), Position = UDim2.new(1, -104, 0, 2), Parent = row })
	end
	UI.button("Close", function()
		gui:Destroy()
	end, { Parent = frame })
end

function enterHangar()
	clearFlight()
	if hangar then
		hangar:destroy()
		hangar = nil
	end
	mode = "hangar"
	campaign.cargo = {}
	campaign.cargoVolume = 0
	local base = homeBase()
	local origin = CFrame.new(-base.position.X, WorldMap.height(base.position.X, base.position.Z) + 3.5, base.position.Z)
	if streamer then
		streamer:setFocus(origin.Position)
	end
	hangar = Hangar.new(campaign, design, origin, {
		fly = function()
			if #design.parts == 0 then
				UI.toast(hangar.gui, "Build a plane first", C.bad)
				return
			end
			save()
			startFlight(base)
		end,
		menu = function()
			save()
			showMenu()
		end,
		designs = designsMenu,
		changed = save,
	})
end

local function gameOver(text)
	local options = {}
	local last = airportById(campaign.lastAirportId)
	if last and not last.isBase then
		table.insert(options, { "Last airport", function()
			startFlight(last)
		end })
	end
	table.insert(options, { "Hangar", function()
		enterHangar()
	end })
	UI.gameOver(text, options)
end

function startFlight(airport)
	if hangar then
		hangar:destroy()
		hangar = nil
	end
	clearFlight()
	mode = "flight"
	campaign.lastAirportId = airport.id
	local spawnPos = robloxPos(airport)
	streamer:ensureNear(spawnPos)
	local cf = spawnCFrame(airport)
	flight = Flight.new(design, cf, { campaign = campaign, infiniteFuel = campaign.creative })
	cam.distance = nil
	cam.yaw, cam.pitch = 0, 0.25

	local atAirport = nil
	local landedTimer = 0
	local outOfFuel = 0
	local autosave = 0
	local prevVelocity = Vector3.zero
	local pending = { retract = false, decouple = false }

	hud = UI.HUD.new({
		openAirport = function()
			if atAirport then
				airportPanel:open(atAirport, campaign, flight)
			end
		end,
		openMap = function() end,
		showControls = function()
			UI.modal("Controls", UI.ControlsText)
		end,
	})
	mapView = UI.MapView.new()
	airportPanel = UI.AirportPanel.new({
		refuel = function()
			flight:refuel()
		end,
		hangar = function()
			airportPanel:close()
			save()
			enterHangar()
		end,
		cargoChanged = function()
			flight:updateMass()
		end,
	})
	local function questTargets()
		local out = {}
		for _, item in campaign:activeQuests() do
			local _, target = campaign:questStage(item.quest, flight.cargoVolume)
			if target then
				table.insert(out, target)
			end
		end
		return out
	end
	hud.gui:FindFirstChild("Map (M)", true)
	local function toggleMap()
		mapView:toggle(campaign, flight.root.Position, flight.root.CFrame:VectorToWorldSpace(flight.localForward), questTargets())
	end
	for _, b in hud.gui:GetDescendants() do
		if b:IsA("TextButton") and b.Text == "Map (M)" then
			b.Activated:Connect(toggleMap)
		end
	end

	flight.onExploded = function()
		campaign.cargo = {}
		campaign.cargoVolume = 0
		task.delay(1.5, function()
			if mode == "flight" then
				gameOver("You Crashed")
			end
		end)
	end

	table.insert(flightConnections, UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			cam.dragging = true
		end
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.G then
			pending.retract = true
		elseif input.KeyCode == Enum.KeyCode.F then
			pending.decouple = true
		elseif input.KeyCode == Enum.KeyCode.M then
			toggleMap()
		elseif input.KeyCode == Enum.KeyCode.C then
			cam.cockpit = not cam.cockpit
		elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
			if messages:isOpen() then
				messages:advance()
			elseif atAirport and not airportPanel:isOpen() then
				airportPanel:open(atAirport, campaign, flight)
			elseif airportPanel:isOpen() then
				airportPanel:close()
			end
		end
	end))
	table.insert(flightConnections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			cam.dragging = false
		end
	end))
	table.insert(flightConnections, UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseMovement and cam.dragging then
			cam.yaw -= input.Delta.X * 0.006
			cam.pitch = math.clamp(cam.pitch + input.Delta.Y * 0.006, -1.2, 1.3)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			cam.distance = math.clamp((cam.distance or 10) * (1 - input.Position.Z * 0.1), 2, 300)
		end
	end))

	table.insert(flightConnections, RunService.PreSimulation:Connect(function(dt)
		if not flight or flight.exploded then
			return
		end
		local input = readInput()
		if airportPanel:isOpen() then
			input.throttle = math.min(input.throttle, 0)
		end
		input.retractPressed = pending.retract
		input.decouplePressed = pending.decouple
		pending.retract, pending.decouple = false, false
		flight:step(dt, input)
	end))

	table.insert(flightConnections, RunService.RenderStepped:Connect(function(dt)
		UserInputService.MouseBehavior = if cam.dragging then Enum.MouseBehavior.LockCurrentPosition else Enum.MouseBehavior.Default
		updateFlightCamera(dt)
	end))

	table.insert(flightConnections, RunService.Heartbeat:Connect(function(dt)
		if not flight then
			return
		end
		local pos = flight.root.Position
		streamer:setFocus(pos)
		local t = flight:telemetry()
		local ux, uz = -pos.X, pos.Z
		campaign:reveal(ux, uz, 1)

		-- airport detection (PlaneContainer.IsAtAirport)
		local closest = WorldMap.closestAirport(ux, uz)
		local horizontalSpeed = flight.root.AssemblyLinearVelocity
		horizontalSpeed = Vector3.new(horizontalSpeed.X, 0, horizontalSpeed.Z).Magnitude
		local vel = flight.root.AssemblyLinearVelocity
		local speedFactor = vel.Magnitude * (1 - (if vel.Magnitude > 1e-3 then vel.Unit.Y else 0))
		local grounded = t.grounded or (flight.hasBalloons and closest and closest.isBase)
		local nowAt = nil
		if closest and not flight.exploded and grounded and speedFactor < 25 and WorldMap.distanceToRect(closest.flatness, ux, uz) < 100 then
			nowAt = closest
		end
		atAirport = nowAt
		if atAirport then
			landedTimer += dt
			if landedTimer > 0.25 then
				landedTimer = 0
				campaign:landed(atAirport, { position = pos, speed = vel.Magnitude, airport = atAirport, maxCargoVolume = flight.cargoVolume })
				flight:updateMass()
			end
			autosave += dt
			if autosave > 120 then
				autosave = 0
				save()
			end
		elseif airportPanel:isOpen() then
			airportPanel:close()
		end

		-- cargo: perishable timers & fragile breakage
		local dv = (flight.root.AssemblyLinearVelocity - prevVelocity).Magnitude
		prevVelocity = flight.root.AssemblyLinearVelocity
		local cargoMsg = campaign:updateCargo(dt, dv, os.clock())
		if cargoMsg then
			UI.toast(hud.gui, cargoMsg, C.bad)
			flight:updateMass()
		end

		-- scrap piles
		local got = campaign:collectScrapNear(ux, uz)
		if got then
			UI.toast(hud.gui, "⚙ 5 Scrap added — research new parts at base", C.good)
		end

		-- story
		local story = campaign:updateStory({ dt = dt, position = pos, heightAboveGround = t.height, atAirport = atAirport ~= nil, exploded = flight.exploded, messageOpen = messages:isOpen() })
		cam.shake = story.shake
		if story.explode then
			flight:explodePlane()
		end
		if story.finished then
			save()
		end

		-- out of fuel (GameOver)
		local refuelHere = atAirport and (atAirport.data.refuel or atAirport.isBase)
		if vel.Magnitude < 25 and not refuelHere and t.fuel < 0.001 and t.fuelCapacity > 0 then
			outOfFuel += dt
		else
			outOfFuel = 0
		end
		if outOfFuel > 6 and not flight.exploded then
			outOfFuel = -math.huge
			gameOver("Out Of Fuel")
		end

		-- HUD
		local lines = {}
		for _, item in campaign:activeQuests() do
			local stage = campaign:questStage(item.quest, flight.cargoVolume)
			table.insert(lines, "<b>" .. item.airport.name .. "</b>: " .. (stage or item.quest.name))
		end
		hud:update(t, campaign, if #lines > 0 then table.concat(lines, "\n") else "Land at an airport to get a job.", atAirport)
	end))

	flight:refuel()
	messages:push(if campaign.creative then "Creative mode: unlimited money and every part unlocked." else "Fly to the airports, pick up cargo and deliver it. Land slowly on a runway, then press Enter for the airport menu.", "Misc")
end

-- ------------------------------------------------------------------------------------------- menu
function showMenu()
	if hangar then
		hangar:destroy()
		hangar = nil
	end
	clearFlight()
	mode = "menu"
	local gui = UI.screen("Menu", 50)
	local back = UI.new("Frame", { BackgroundColor3 = Color3.fromRGB(20, 40, 60), BackgroundTransparency = 0.25, Size = UDim2.new(1, 0, 1, 0), Parent = gui })
	local box = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 420, 0, 520), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Parent = back })
	UI.list(nil, 12, Enum.HorizontalAlignment.Center).Parent = box
	UI.label("AVIASSEMBLY", 56, { Font = UI.FontBold, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 70), Parent = box })
	UI.label("Build planes. Fly cargo. Save the islands.", 16, { TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.muted, Parent = box })
	local function start(c)
		campaign = c
		hookCampaign()
		gui:Destroy()
		if not streamer then
			streamer = WorldStreamer.new(campaign)
		else
			streamer.campaign = campaign
		end
		enterHangar()
	end
	if saveData then
		UI.button("<b>Continue</b>", function()
			local c = Campaign.deserialize(saveData.campaign)
			design = PlaneDesign.deserialize(saveData.design)
			savedDesigns = saveData.designs or {}
			start(c)
		end, { Size = UDim2.new(0, 300, 0, 48), BackgroundColor3 = C.accent, TextColor3 = C.text, Parent = box })
	end
	for _, diff in { "Relaxed", "Normal", "Hard" } do
		UI.button("New campaign — " .. diff, function()
			design = PlaneDesign.new()
			start(Campaign.new(diff, false))
		end, { Size = UDim2.new(0, 300, 0, 44), Parent = box })
	end
	UI.button("Creative mode", function()
		design = PlaneDesign.new()
		start(Campaign.new("Normal", true))
	end, { Size = UDim2.new(0, 300, 0, 44), Parent = box })
	UI.button("Controls", function()
		UI.modal("Controls", UI.ControlsText)
	end, { Size = UDim2.new(0, 300, 0, 40), Parent = box })
	if not PartVisual.hasImportedMeshes() then
		UI.label('<font color="#E0A040">3D models not imported yet — parts show as coloured blocks. See the README to import the .glb files.</font>', 14, { TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = box })
	end
	camera.CFrame = CFrame.lookAt(Vector3.new(60, 40, -120), Vector3.new(0, 0, 0))
end

-- ------------------------------------------------------------------------------------------- boot
saveData = load()
showMenu()
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="31">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">25.5</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>