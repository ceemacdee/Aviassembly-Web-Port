      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Fuselage</string>
          <string name="Source"><![CDATA[--!strict
-- Procedural fuselage ("Body" part), ported from ProceduralFuselageMesh / ProceduralFuselage / FuselageData.
-- Geometry is generated in Unity part space and returned mirrored on X (Roblox part space).
local Fuselage = {}

export type Side = { radius: Vector2, roundness: { number }, lengthOffset: Vector3 }
export type Settings = { side1: Side, side2: Side }

-- Resolution per side of the cross-section. The original used 64 (smooth); Roblox draws triangles with
-- wedge parts, so a lower resolution keeps the part count reasonable while staying visually round.
Fuselage.Resolution = 4

function Fuselage.default(): Settings
	return {
		side1 = { radius = Vector2.new(0.5, 0.5), roundness = { 1, 1, 1, 1 }, lengthOffset = Vector3.new(0, 0, 0.5) },
		side2 = { radius = Vector2.new(0.5, 0.5), roundness = { 1, 1, 1, 1 }, lengthOffset = Vector3.new(0, 0, 0.5) },
	}
end

function Fuselage.copy(s: Settings): Settings
	return {
		side1 = { radius = s.side1.radius, roundness = table.clone(s.side1.roundness), lengthOffset = s.side1.lengthOffset },
		side2 = { radius = s.side2.radius, roundness = table.clone(s.side2.roundness), lengthOffset = s.side2.lengthOffset },
	}
end

local function closestCornerIndex(p: Vector3, corners: { Vector3 }): number
	local best, bestD = 1, math.huge
	for i, c in corners do
		local d = (p - c).Magnitude
		if d < bestD then
			bestD = d
			best = i
		end
	end
	return best
end

-- GenerateVertices: a rounded rectangle ring at depth position.Z.
local function ring(size: Vector2, position: Vector3, bevel: { number }, resolution: number): { Vector3 }
	local corners = {
		Vector3.new(-size.X + position.X, -size.Y + position.Y, position.Z),
		Vector3.new(-size.X + position.X, size.Y + position.Y, position.Z),
		Vector3.new(size.X + position.X, size.Y + position.Y, position.Z),
		Vector3.new(size.X + position.X, -size.Y + position.Y, position.Z),
	}
	local stepX = size.X * 2 / resolution
	local stepY = size.Y * 2 / resolution
	local pts = {}
	local p = corners[1]
	local dir = (corners[2] - p).Unit
	local count = 0
	for _ = 1, resolution * 4 do
		table.insert(pts, p)
		local step = if math.abs(dir.X) < 0.1 then stepY else stepX
		p += dir * step
		count += 1
		if count == resolution then
			-- rotate -90 degrees about Z (Unity): (x, y) -> (y, -x)
			dir = Vector3.new(dir.Y, -dir.X, 0)
			count = 0
		end
	end
	local minSize = math.min(size.X, size.Y)
	for i, v in pts do
		local index = closestCornerIndex(v, corners)
		local corner = corners[index]
		local distance = (v - corner).Magnitude
		local r = math.clamp(bevel[index], 0, 1) * minSize
		if distance < r then
			local n = Vector3.new(math.sign(corner.X - position.X), math.sign(corner.Y - position.Y), 0).Unit
			local center = corner - n * math.sqrt(r * r + r * r)
			pts[i] = center + (v - center).Unit * r
		end
	end
	return pts
end

local function center(points: { Vector3 }): Vector3
	local sum = Vector3.zero
	for _, p in points do
		sum += p
	end
	return sum / #points
end

-- Returns triangles { {a, b, c}, ... } in Unity part space.
function Fuselage.triangles(s: Settings, resolution: number?): { { Vector3 } }
	local res = resolution or Fuselage.Resolution
	local r1 = ring(s.side1.radius, Vector3.new(s.side1.lengthOffset.X, s.side1.lengthOffset.Y, s.side1.lengthOffset.Z), s.side1.roundness, res)
	local r2 = ring(s.side2.radius, Vector3.new(s.side2.lengthOffset.X, s.side2.lengthOffset.Y, -s.side2.lengthOffset.Z), s.side2.roundness, res)
	local tris = {}
	local n = #r1
	for i = 1, n do
		local j = i % n + 1
		table.insert(tris, { r1[i], r1[j], r2[j] })
		table.insert(tris, { r1[i], r2[j], r2[i] })
	end
	local c1, c2 = center(r1), center(r2)
	for i = 1, n do
		local j = i % n + 1
		table.insert(tris, { c1, r1[j], r1[i] })
		table.insert(tris, { c2, r2[i], r2[j] })
	end
	return tris
end

-- Signed-volume sum, like GetMeshVolume (computed on the full 64-resolution mesh in the original).
function Fuselage.volume(s: Settings): number
	local total = 0
	for _, t in Fuselage.triangles(s, 16) do
		local a, b, c = t[1], t[2], t[3]
		total += a:Dot(b:Cross(c)) / 6
	end
	return math.abs(total)
end

local DEFAULT_VOLUME = Fuselage.volume(Fuselage.default())

-- FuselageData.ChangeVolume: cargo, weight and price scale with the body's volume.
function Fuselage.stats(s: Settings, baseCargo: number, baseWeight: number, basePrice: number)
	local v = Fuselage.volume(s)
	local k = v / DEFAULT_VOLUME
	return { cargoVolume = baseCargo * k, weight = baseWeight * k, price = basePrice * k, volume = v }
end

-- Snap points p1 / p2 and the attach point, in Unity part space.
function Fuselage.endPoints(s: Settings): (Vector3, Vector3)
	local p1 = Vector3.new(s.side1.lengthOffset.X, s.side1.lengthOffset.Y, s.side1.lengthOffset.Z)
	local p2 = Vector3.new(s.side2.lengthOffset.X, s.side2.lengthOffset.Y, -s.side2.lengthOffset.Z)
	return p1, p2
end

function Fuselage.length(s: Settings): number
	return math.abs(s.side1.lengthOffset.Z + s.side2.lengthOffset.Z)
end

-- Serialisation helpers (DataStore friendly).
function Fuselage.encode(s: Settings): { number }
	local a, b = s.side1, s.side2
	return {
		a.radius.X, a.radius.Y, a.lengthOffset.X, a.lengthOffset.Y, a.lengthOffset.Z, a.roundness[1], a.roundness[2], a.roundness[3], a.roundness[4],
		b.radius.X, b.radius.Y, b.lengthOffset.X, b.lengthOffset.Y, b.lengthOffset.Z, b.roundness[1], b.roundness[2], b.roundness[3], b.roundness[4],
	}
end

function Fuselage.decode(t: { number }?): Settings
	if not t or #t < 18 then
		return Fuselage.default()
	end
	return {
		side1 = { radius = Vector2.new(t[1], t[2]), lengthOffset = Vector3.new(t[3], t[4], t[5]), roundness = { t[6], t[7], t[8], t[9] } },
		side2 = { radius = Vector2.new(t[10], t[11]), lengthOffset = Vector3.new(t[12], t[13], t[14]), roundness = { t[15], t[16], t[17], t[18] } },
	}
end

return Fuselage
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MathUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Small math helpers matching the Unity functions the original game used (Mathf.*, AnimationCurve, etc.).
local MathUtil = {}

function MathUtil.clamp01(x: number): number
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end

function MathUtil.lerp(a: number, b: number, t: number): number
	return a + (b - a) * MathUtil.clamp01(t)
end

function MathUtil.lerpUnclamped(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function MathUtil.inverseLerp(a: number, b: number, v: number): number
	if a == b then
		return 0
	end
	return MathUtil.clamp01((v - a) / (b - a))
end

function MathUtil.moveTowards(current: number, target: number, maxDelta: number): number
	if math.abs(target - current) <= maxDelta then
		return target
	end
	return current + math.sign(target - current) * maxDelta
end

function MathUtil.sign(x: number): number
	-- Unity's Mathf.Sign returns 1 for 0.
	return if x >= 0 then 1 else -1
end

function MathUtil.snapToIncrement(value: number, increment: number): number
	return math.floor(value / increment + 0.5) * increment
end

-- Unity's Mathf.SmoothDamp. Returns newValue, newVelocity.
function MathUtil.smoothDamp(current: number, target: number, velocity: number, smoothTime: number, dt: number): (number, number)
	smoothTime = math.max(0.0001, smoothTime)
	local omega = 2 / smoothTime
	local x = omega * dt
	local exp = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)
	local change = current - target
	local originalTo = target
	local temp = (velocity + omega * change) * dt
	velocity = (velocity - omega * temp) * exp
	local output = target + (change + temp) * exp
	if (originalTo - current > 0) == (output > originalTo) then
		output = originalTo
		velocity = (output - originalTo) / dt
	end
	return output, velocity
end

-- Evaluate a Unity AnimationCurve exported as { {time, value, inSlope, outSlope}, ... } (clamped outside the keys).
function MathUtil.evaluateCurve(keys: { { number } }, t: number): number
	local n = #keys
	if n == 0 then
		return 0
	end
	if t <= keys[1][1] then
		return keys[1][2]
	end
	if t >= keys[n][1] then
		return keys[n][2]
	end
	for i = 1, n - 1 do
		local k0, k1 = keys[i], keys[i + 1]
		if t <= k1[1] then
			local dt = k1[1] - k0[1]
			local s = (t - k0[1]) / dt
			local m0 = k0[4] * dt
			local m1 = k1[3] * dt
			local s2, s3 = s * s, s * s * s
			return (2 * s3 - 3 * s2 + 1) * k0[2] + (s3 - 2 * s2 + s) * m0 + (-2 * s3 + 3 * s2) * k1[2] + (s3 - s2) * m1
		end
	end
	return keys[n][2]
end

-- Signed angle (degrees) from a to b around axis, like Vector3.SignedAngle.
function MathUtil.signedAngle(a: Vector3, b: Vector3, axis: Vector3): number
	local am, bm = a.Magnitude, b.Magnitude
	if am < 1e-9 or bm < 1e-9 then
		return 0
	end
	local cos = math.clamp(a:Dot(b) / (am * bm), -1, 1)
	local angle = math.deg(math.acos(cos))
	-- Same formula as Unity. All vectors in this port are Unity vectors mirrored on X; axes built from
	-- cross products pick up the matching sign, so the physics formulas carry over unchanged.
	local s = axis:Dot(a:Cross(b))
	return if s < 0 then -angle else angle
end

function MathUtil.safeUnit(v: Vector3): Vector3
	local m = v.Magnitude
	if m < 1e-9 then
		return Vector3.zero
	end
	return v / m
end

function MathUtil.projectOnPlane(v: Vector3, normal: Vector3): Vector3
	local n = MathUtil.safeUnit(normal)
	return v - n * v:Dot(n)
end

function MathUtil.formatNumber(n: number): string
	local s = tostring(math.floor(n + 0.5))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

return MathUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Noise</string>
            <string name="Source"><![CDATA[--!strict
-- Terrain noise, ported from NoiceGenerator.cs. Unity's Mathf.PerlinNoise is closed source, so this is
-- classic improved Perlin noise remapped to Unity's [0, 1] range; terrain has the same character and scale
-- as the original but not identical hills.
local Noise = {}

local perm: { number } = {}
do
	local p = {
		151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30, 69, 142, 8, 99, 37, 240,
		21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88,
		237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231,
		83, 111, 229, 122, 60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1,
		216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173,
		186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16,
		58, 17, 182, 189, 28, 42, 223, 183, 170, 213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43,
		172, 9, 129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34,
		242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199,
		106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93, 222, 114, 67, 29, 24, 72,
		243, 141, 128, 195, 78, 66, 215, 61, 156, 180,
	}
	for i = 0, 511 do
		perm[i] = p[(i % 256) + 1]
	end
end

local function fade(t: number): number
	return t * t * t * (t * (t * 6 - 15) + 10)
end

local function grad(hash: number, x: number, y: number): number
	local h = hash % 8
	local u = if h < 4 then x else y
	local v = if h < 4 then y else x
	return (if h % 2 == 0 then u else -u) + (if math.floor(h / 2) % 2 == 0 then 2 * v else -2 * v)
end

-- 2D Perlin noise in [0, 1] (Unity convention).
function Noise.perlin(x: number, y: number): number
	local xi = math.floor(x)
	local yi = math.floor(y)
	local xf = x - xi
	local yf = y - yi
	xi = xi % 256
	yi = yi % 256
	local u = fade(xf)
	local v = fade(yf)
	local aa = perm[perm[xi] + yi]
	local ab = perm[perm[xi] + yi + 1]
	local ba = perm[perm[xi + 1] + yi]
	local bb = perm[perm[xi + 1] + yi + 1]
	local x1 = grad(aa, xf, yf) + (grad(ba, xf - 1, yf) - grad(aa, xf, yf)) * u
	local x2 = grad(ab, xf, yf - 1) + (grad(bb, xf - 1, yf - 1) - grad(ab, xf, yf - 1)) * u
	local n = x1 + (x2 - x1) * v
	-- grad() output spans roughly [-2.2, 2.2]; scale into Unity's 0..1 with mean 0.5.
	return math.clamp(0.5 + n * 0.25, -0.1, 1.1)
end

local function perlinOffset(x: number, y: number): number
	return Noise.perlin(x + 10000, y + 10000)
end

local function fbm(x: number, y: number, octaves: number): number
	local total = 0
	for i = 0, octaves - 1 do
		local f = 2 ^ i
		total += (1 / f) * perlinOffset(f * x, f * y)
	end
	return total
end

-- NoiceGenerator.GetNoice: domain-warped fractional Brownian motion.
function Noise.getNoise(x: number, y: number, octaves: number): number
	local qx = fbm(x, y, octaves)
	local qy = fbm(x + 5.2, y + 1.3, octaves)
	return fbm(x + 4 * qx, y + 4 * qy, octaves) - 0.5
end

return Noise
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">WorldMap</string>
          <string name="Source"><![CDATA[--!strict
-- The campaign world: continents, airports and the terrain height function.
-- Ported from ContinentManager, ContinentData, AirportSpawner, AirportManager, TerrainGenerationManager,
-- FlatnessRectangle and ConvexHull2D. Internally everything runs in *Unity* coordinates (x not mirrored) so the
-- noise and layout match the original; use WorldMap.toRoblox / fromRoblox at the boundaries.
local Shared = script.Parent
local World = require(Shared.Data.World)
local Constants = require(Shared.Data.Constants)
local Noise = require(Shared.Util.Noise)
local MathUtil = require(Shared.Util.MathUtil)

local WorldMap = {}

export type Rect = {
	center: Vector2,
	size: Vector2,
	rotation: number,
	cosR: number,
	sinR: number,
	minX: number,
	maxX: number,
	minY: number,
	maxY: number,
}

export type Airport = {
	index: number,
	id: string,
	name: string,
	data: any,
	continent: any,
	position: Vector3, -- Unity space, y = 0
	isBase: boolean,
	rotation: number, -- yaw in degrees (Unity)
	flatness: Rect,
	cargoTypes: { string },
}

local TERRAIN = Constants.Terrain
local CHUNK = TERRAIN.chunkSize
local NOISE_SCALE = TERRAIN.noiseScale
local OCTAVES = TERRAIN.octaves
WorldMap.SeaLevel = -8
WorldMap.ChunkSize = CHUNK

function WorldMap.toRoblox(p: Vector3): Vector3
	return Vector3.new(-p.X, p.Y, p.Z)
end

function WorldMap.fromRoblox(p: Vector3): Vector3
	return Vector3.new(-p.X, p.Y, p.Z)
end

-- ---------------------------------------------------------------------------------------------- rectangles
local function newRect(size: Vector2, center: Vector2, rotation: number): Rect
	local r = math.rad(rotation)
	return {
		center = center,
		size = size,
		rotation = rotation,
		cosR = math.cos(r),
		sinR = math.sin(r),
		minX = center.X - size.X,
		maxX = center.X + size.X,
		minY = center.Y - size.Y,
		maxY = center.Y + size.Y,
	}
end

function WorldMap.distanceToRect(rect: Rect, x: number, z: number): number
	local dx = x - rect.center.X
	local dz = z - rect.center.Y
	local rx = dx * rect.cosR - dz * rect.sinR + rect.center.X
	local rz = dx * rect.sinR + dz * rect.cosR + rect.center.Y
	local cx = math.max(rect.minX, math.min(rx, rect.maxX))
	local cz = math.max(rect.minY, math.min(rz, rect.maxY))
	local ex, ez = rx - cx, rz - cz
	return math.sqrt(ex * ex + ez * ez)
end

-- ---------------------------------------------------------------------------------------------- convex hull
local function convexHull(points: { Vector2 }): { Vector2 }
	if #points < 3 then
		return table.clone(points)
	end
	local pts = table.clone(points)
	table.sort(pts, function(a, b)
		return a.X < b.X or (a.X == b.X and a.Y < b.Y)
	end)
	local function cross(o: Vector2, a: Vector2, b: Vector2)
		return (a.X - o.X) * (b.Y - o.Y) - (a.Y - o.Y) * (b.X - o.X)
	end
	local lower, upper = {}, {}
	for _, p in pts do
		while #lower >= 2 and cross(lower[#lower - 1], lower[#lower], p) <= 0 do
			table.remove(lower)
		end
		table.insert(lower, p)
	end
	for i = #pts, 1, -1 do
		local p = pts[i]
		while #upper >= 2 and cross(upper[#upper - 1], upper[#upper], p) <= 0 do
			table.remove(upper)
		end
		table.insert(upper, p)
	end
	table.remove(lower)
	table.remove(upper)
	for _, p in upper do
		table.insert(lower, p)
	end
	return lower
end

local function pointInHull(hull: { Vector2 }, x: number, z: number): boolean
	local n = #hull
	if n < 3 then
		return false
	end
	for i = 1, n do
		local a, b = hull[i], hull[i % n + 1]
		if (b.X - a.X) * (z - a.Y) - (b.Y - a.Y) * (x - a.X) < 0 then
			return false
		end
	end
	return true
end

local function distanceToSegment(px: number, pz: number, a: Vector2, b: Vector2): number
	local abx, abz = b.X - a.X, b.Y - a.Y
	local len2 = abx * abx + abz * abz
	local t = 0
	if len2 > 0 then
		t = math.clamp(((px - a.X) * abx + (pz - a.Y) * abz) / len2, 0, 1)
	end
	local cx, cz = a.X + abx * t - px, a.Y + abz * t - pz
	return math.sqrt(cx * cx + cz * cz)
end

local function hullDistance(continent: any, x: number, z: number): number
	local hull = continent.hull
	if #hull == 0 then
		local o = continent.origin
		local dx, dz = o.X - x, o.Z - z
		return math.sqrt(dx * dx + dz * dz)
	elseif #hull == 1 then
		local dx, dz = hull[1].X - x, hull[1].Y - z
		return math.sqrt(dx * dx + dz * dz)
	end
	if pointInHull(hull, x, z) then
		return 0
	end
	local best = math.huge
	local n = #hull
	for i = 1, n do
		local d = distanceToSegment(x, z, hull[i], hull[i % n + 1])
		if d < best then
			best = d
		end
	end
	return best
end

-- ---------------------------------------------------------------------------------------------- continents & airports
WorldMap.Continents = {} :: { any }
WorldMap.Airports = {} :: { Airport }
WorldMap.CargoTypes = {} :: { [string]: any }
WorldMap.CargoOrder = {} :: { string }
local flatObjects: { { rect: Rect, height: number, blending: number, position: Vector3 } } = {}

for _, cargo in World.cargoTypes do
	WorldMap.CargoTypes[cargo.id] = cargo
	table.insert(WorldMap.CargoOrder, cargo.id)
end

local function airportUnityPosition(data: any): Vector3
	-- World.lua stores positions mirrored for Roblox; undo that for the Unity-space simulation.
	return Vector3.new(-data.position[1], 0, data.position[3])
end

do
	-- ContinentManager.Init: continent 0 sits in front of the origin, the others at the mean of their airports.
	for index, c in World.continents do
		local continent = {
			index = index,
			type = c,
			name = c.name,
			radius = c.radius,
			minHeight = c.minHeight,
			maxHeight = c.maxHeight,
			airports = {},
			hull = {},
			origin = Vector3.zero,
		}
		if index == 1 then
			continent.origin = Vector3.new(0, 0, 1) * (c.radius - 750)
		else
			local sum, count = Vector3.zero, 0
			for _, a in c.airports do
				if not a.offshore then
					sum += airportUnityPosition(a)
					count += 1
				end
			end
			local mean = if count > 0 then sum / count else Vector3.zero
			local maxDist = 0
			for _, a in c.airports do
				if not a.offshore then
					maxDist = math.max(maxDist, (mean - airportUnityPosition(a)).Magnitude)
				end
			end
			continent.radius = math.max(1000, maxDist * 1.1)
			continent.origin = mean
		end
		table.insert(WorldMap.Continents, continent)
	end

	for _, continent in WorldMap.Continents do
		for _, a in continent.type.airports do
			local airport: Airport = {
				index = #WorldMap.Airports + 1,
				id = (a.id .. continent.type.id):gsub("%s+", ""),
				name = a.name,
				data = a,
				continent = continent,
				position = airportUnityPosition(a),
				isBase = false,
				rotation = 0,
				flatness = newRect(Vector2.new(100, 300), Vector2.zero, 0),
				cargoTypes = a.cargoTypes or {},
			}
			table.insert(continent.airports, airport)
			table.insert(WorldMap.Airports, airport)
		end
		-- UpdateBaseAirport: the airport closest to the world origin is the continent's base.
		local base, best = nil, math.huge
		for _, airport in continent.airports do
			local m = airport.position.Magnitude
			if m < best then
				best = m
				base = airport
			end
		end
		if base then
			base.isBase = true
			base.cargoTypes = {}
			continent.baseAirport = base
		end
		-- UpdateConvexHull (offshore airports excluded)
		local pts = {}
		for _, airport in continent.airports do
			if not airport.data.offshore then
				table.insert(pts, Vector2.new(airport.position.X, airport.position.Z))
			end
		end
		continent.hull = convexHull(pts)
	end
end

function WorldMap.closestContinent(x: number, z: number): any
	local best, bestD = WorldMap.Continents[1], math.huge
	for _, c in WorldMap.Continents do
		local d = hullDistance(c, x, z)
		if d < bestD then
			bestD = d
			best = c
		end
	end
	return best, bestD
end

local function continentFalloff(d: number): number
	return 1 - MathUtil.clamp01(d * 0.0003)
end

-- TerrainGenerationManager.GetTerrainHeightFast (without flattening) for a Unity-space point.
function WorldMap.baseHeight(x: number, z: number): number
	local noise = Noise.getNoise(x / CHUNK * NOISE_SCALE, z / CHUNK * NOISE_SCALE, OCTAVES)
	local continent, d = WorldMap.closestContinent(x, z)
	-- continentFalloff curve is linear 0..1 (keys (0,0) and (1,1) with slope 1).
	noise -= 1 - continentFalloff(d)
	return MathUtil.lerp(continent.minHeight, continent.maxHeight, MathUtil.clamp01(noise))
end

local function flatAdjusted(x: number, z: number, base: number): number
	local blend = 1
	local target = base
	for _, f in flatObjects do
		local t = MathUtil.clamp01(WorldMap.distanceToRect(f.rect, x, z) / f.blending)
		if t < 0.99 then
			blend = t
			target = f.height
		end
	end
	local t = MathUtil.clamp01(blend - 0.25) * 1.33333
	return MathUtil.lerp(target, base, t)
end

function WorldMap.height(x: number, z: number): number
	return flatAdjusted(x, z, WorldMap.baseHeight(x, z))
end

-- Roblox-space convenience.
function WorldMap.heightAt(robloxPosition: Vector3): number
	return WorldMap.height(-robloxPosition.X, robloxPosition.Z)
end

-- GetAvarageTerrainHeight, including the original's quirk of sampling around z = 0 (it used position.y).
local function averageHeight(position: Vector3): number
	local samples = 5
	local spacing = 1000 / samples
	local cx = math.floor(position.X / 1000) * 1000
	local cz = math.floor(position.Y / 1000) * 1000
	local total = 0
	for i = 0, samples - 1 do
		for j = 0, samples - 1 do
			total += WorldMap.baseHeight(cx - 500 + i * spacing, cz - 500 + j * spacing)
		end
	end
	return math.max(math.floor(total / (samples * samples) + 0.5), 0)
end

-- AirportManager.InitFlatObjects
for _, airport in WorldMap.Airports do
	local data = airport.data
	local rotation = (airport.position.X + airport.position.Z - 110) % 360
	if data.rotationOverride then
		rotation = data.rotation
	end
	if airport.isBase then
		rotation = 0
	end
	airport.rotation = rotation
	local fp = Vector2.new(data.footprint[1], data.footprint[2])
	local size = if fp.Magnitude < 10 then Vector2.new(100, 300) else fp
	local blending = if data.blendingDistance < 10 then 200 else data.blendingDistance
	if airport.isBase then
		blending = 1000
	end
	if airport.position.Magnitude < 200 then
		blending = 200
	end
	airport.flatness = newRect(size, Vector2.new(airport.position.X, airport.position.Z), rotation)
	if not data.offshore then
		table.insert(flatObjects, {
			rect = airport.flatness,
			height = averageHeight(airport.position),
			blending = blending,
			position = airport.position,
		})
	end
end

-- AirportManager.GetAirportRotation (yaw in Unity degrees).
function WorldMap.airportYaw(airport: Airport): number
	local yaw = 0
	local _closest = WorldMap.closestAirport(airport.position.X, airport.position.Z)
	if not (_closest and _closest.isBase) then
		yaw = (airport.position.X + airport.position.Z - 110) % 360
	end
	if airport.data.rotationOverride then
		yaw = airport.data.rotation
	end
	return yaw
end

function WorldMap.closestAirport(x: number, z: number, cargoId: string?): Airport?
	local best, bestD = nil, math.huge
	for _, airport in WorldMap.Airports do
		if cargoId == nil or table.find(airport.cargoTypes, cargoId) then
			local dx, dz = airport.position.X - x, airport.position.Z - z
			local d = dx * dx + dz * dz
			if d < bestD then
				bestD = d
				best = airport
			end
		end
	end
	return best
end

-- Where the airport model sits (Chunk.SpawnAirport): terrain height under the centre, never below -8.
function WorldMap.airportHeight(airport: Airport): number
	return math.max(WorldMap.height(airport.position.X, airport.position.Z), -8)
end

-- Roblox CFrame of the airport model root.
function WorldMap.airportCFrame(airport: Airport): CFrame
	local p = airport.position
	return CFrame.new(-p.X, WorldMap.airportHeight(airport), p.Z) * CFrame.Angles(0, -math.rad(WorldMap.airportYaw(airport)), 0)
end

-- Airport.GetPrice: cargo gets more valuable the further it has to travel.
function WorldMap.cargoPrice(airport: Airport, cargoId: string): number
	local cargo = WorldMap.CargoTypes[cargoId]
	local source = WorldMap.closestAirport(airport.position.X, airport.position.Z, cargoId)
	local distance = 0
	if source then
		distance = (source.position - airport.position).Magnitude
	end
	local steps = math.floor(distance / 500) * 500 / 3000
	local factor = if cargo.expires then 0.5 else 0.25
	return cargo.basePrice * (1 + steps * factor)
end

function WorldMap.isOcean(x: number, z: number): boolean
	local c = WorldMap.closestContinent(x, z)
	local dx, dz = x - c.origin.X, z - c.origin.Z
	return math.sqrt(dx * dx + dz * dz) > c.radius * 0.9
end

function WorldMap.airportById(id: string): Airport?
	for _, airport in WorldMap.Airports do
		if airport.id == id then
			return airport
		end
	end
	return nil
end

function WorldMap.findAirport(nameFragment: string): Airport?
	for _, airport in WorldMap.Airports do
		if string.find(airport.name, nameFragment, 1, true) then
			return airport
		end
	end
	return nil
end

-- Terrain colours, from each continent's terrain material.
function WorldMap.terrainColors(x: number, z: number): any
	local c = WorldMap.closestContinent(x, z)
	return c.type.terrain
end

return WorldMap
]]></string>
        </Properties>
      </Item>
    </Item>
